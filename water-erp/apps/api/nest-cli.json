{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.json",
    "assets": [
      { "include": "assets/fonts/*.otf", "outDir": "dist" },
      { "include": "assets/fonts/*.txt", "outDir": "dist" }
    ]
  }
}
