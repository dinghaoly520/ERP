# ── 短信验证码 · 阿里云直连配置（非密钥部分，随 git 分发）──
# 新机器用法：
#   cd water-erp/apps/api
#   bash env/apply-sms-env.sh     # 提示输入解密口令，自动把本文件 + 密钥并入 .env
#   然后重启 :4001（SMS provider 在服务构造时一次性解析，改 .env 不重启不生效）
#
# 密钥（ALIYUN_SMS_ACCESS_KEY_ID/SECRET）在 env/sms-aliyun-keys.enc（AES-256-CBC 加密）。
# 解密口令请走电话/私聊等非 git 渠道获取——本仓库为公开仓库，密钥明文严禁入库。
# 手动解密：openssl enc -d -aes-256-cbc -pbkdf2 -a -in env/sms-aliyun-keys.enc
#
# 本地开发不想接真实短信：把 SMS_PROVIDER 改为 console（验证码打在 API 日志 [SMS-STUB]），
# 并可设 SMS_DEBUG_BYPASS=true 用万能码 123456（仅非生产；生产强制拒绝）。
SMS_PROVIDER=aliyun
ALIYUN_SMS_SIGN_NAME=四川水发勘测设计研究有限公司
ALIYUN_SMS_TEMPLATE_CODE=SMS_337341540
ALIYUN_SMS_TEMPLATE_CODE_SUPPLIER=SMS_512300719
ALIYUN_SMS_TEMPLATE_CODE_MANAGEMENT=SMS_512255689
ALIYUN_SMS_TEMPLATE_CODE_PASSWORD_RESET=SMS_512375698
SMS_DEBUG_BYPASS=false
