DATABASE_URL=postgresql://water_erp:water_erp_dev@localhost:5432/water_erp
JWT_SECRET=change-me-in-production
SMS_DEBUG_BYPASS=true

# ── AI / LLM ──
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-pro

# ── 加密信封 / OCR / 队列（ai-bid-analysis 移植）──
# KMS_SECRET: 信封加密主密钥，openssl rand -hex 32 生成；wrapKey/unwrapKey 强制依赖（缺失则解密全崩）
KMS_SECRET=<openssl rand -hex 32>
# OCR_SERVICE_URL: 复用本机 procurement OCR :8100（rapid 引擎）
OCR_SERVICE_URL=http://localhost:8100
# REDIS_URL: docker-compose 映射 6380→6379
REDIS_URL=redis://localhost:6380
