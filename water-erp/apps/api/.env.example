# 运行时连接：经 pgbouncer transaction 池（docker-compose 服务 water-erp-pgbouncer，6432→容器5432）
DATABASE_URL=postgresql://water_erp:water_erp_dev@localhost:6432/water_erp?pgbouncer=true&connection_limit=10
# 直连（prisma migrate/db execute/db push/studio 专用——transaction 池不支持 CLI 的 prepared statements/advisory locks）
# 注意：prisma studio 不读 directUrl，需 DATABASE_URL="$DIRECT_URL" pnpm db:studio
DIRECT_URL=postgresql://water_erp:water_erp_dev@localhost:5432/water_erp
JWT_SECRET=change-me-in-production
SMS_DEBUG_BYPASS=true

# ── AI / LLM ──
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-pro
# 所有 DeepSeek 调用统一走 local-ai/LlmService 网关；以下两项为网关限流/重试参数
LLM_MAX_CONCURRENCY=10             # 进程内并发信号量：超出的调用排队（防突发并发打爆上游配额）
LLM_MAX_RETRIES=2                  # 429/5xx/网络/超时自动重试次数（指数退避，遵守 Retry-After≤8s；调用方可按次覆盖）

# ── Embedding / pgvector（tender-review 知识库 RAG 必需；缺则知识库上传/语义/通用审查全挂）──
# EMBEDDING_BASE_URL: vLLM bge-m3 的 OpenAI 兼容端点。本机 procurement-embedding 跑在 :8003
#   （vllm serve /home/asus/models/bge-m3 --convert embed）。代码默认 :8001 是错的，必须显式覆盖。
EMBEDDING_BASE_URL=http://localhost:8003/v1
# EMBEDDING_MODEL: vllm 未加 --served-model-name，model id 即磁盘全路径，写 BAAI/bge-m3 会 404
EMBEDDING_MODEL=/home/asus/models/bge-m3
EMBEDDING_API_KEY=
# PGVECTOR_ENABLED=true → VectorInitService 启动建 vector 扩展 + HNSW 索引。前置：
#   docker-compose 的 postgres 镜像须为 pgvector/pgvector:pg16，且 DocumentChunk 含 embedding 列
PGVECTOR_ENABLED=true

# ── 加密信封 / OCR / 队列（ai-bid-analysis 移植）──
# KMS_SECRET: 信封加密主密钥，openssl rand -hex 32 生成；wrapKey/unwrapKey 强制依赖（缺失则解密全崩）
KMS_SECRET=<openssl rand -hex 32>
# OCR_SERVICE_URL: 复用本机 procurement OCR :8100（rapid 引擎）
OCR_SERVICE_URL=http://localhost:8100
# REDIS_URL: docker-compose 映射 6380→6379
REDIS_URL=redis://localhost:6380

# ── 操作日志（OperationLog 全局拦截器，apps/api/src/operation-log）──
OPERATION_LOG_ENABLED=true            # 总开关；设 false 完全停用记录
OPERATION_LOG_EXCLUDE=                # 不记录的路径，逗号分隔，支持 /regex/；务必加入高频轮询端点（开标大厅/评分进度等），否则日志膨胀
OPERATION_LOG_BODY_MAX_KB=4           # 请求体脱敏后截断阈值
OPERATION_LOG_RETENTION_DAYS=180      # 保留天数；OperationLog 为按月 RANGE 分区表，@Cron 每日 04:00 预建未来分区并 DROP 整月过期分区（O(1)）
OPERATION_LOG_PARTITION_MONTHS_AHEAD=2 # cron 预建未来 N 个月分区（防漏建落入 DEFAULT 兜底分区）
