generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 运行时：经 pgbouncer transaction 池（:6432，?pgbouncer=true）
  directUrl = env("DIRECT_URL") // Prisma CLI（migrate/db execute/studio）：绕过 pgbouncer 直连 :5432
}

// ── 基础 ──

// ── 公司主数据（数据隔离的归属单位，2026-08-20）──

model Company {
  id        String   @id @default(cuid())
  name      String   @unique // 规范全称，主数据唯一，杜绝分叉
  shortName String? // 如「建设/投资/设计院」
  createdAt DateTime @default(now())

  users               User[]
  pmItems             ProjectManagementItem[]
  procurementProjects ProcurementProject[]
  procurementRounds   ProcurementRound[]
  bidProjects         BidProject[]
  announcements       Announcement[]

  @@map("companies")
}

model Department {
  id                  String               @id @default(cuid())
  name                String               @unique
  code                String?              @unique
  users               User[]
  procurementProjects ProcurementProject[]
  procurementRounds   ProcurementRound[]   @relation("RoundDepartment")
  requestedProjects   Project[]            @relation("ProjectRequestingDepartment")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model User {
  id             String      @id @default(cuid())
  username       String
  displayName    String
  email          String?
  phone          String?
  officeLocation String?     @map("office_location")
  company        String? // 展示快照（公司改名不影响历史展示）
  companyId      String? // 数据隔离依据 → Company 主数据
  companyRef     Company?    @relation(fields: [companyId], references: [id])
  avatar         String?
  passwordHash   String?
  role           String      @default("internal_user")
  isActive       Boolean     @default(true)
  webSessionId   String? // :3005 单设备登录：每次 web 登录轮换；JWT 里的 sid 与之不符即拒绝（旧设备被顶下线）
  isFrozen       Boolean     @default(false) // 管理员冻结：登录拦截（ACCOUNT_FROZEN）+ 守卫即时 401，区别于未激活 isActive=false
  requestedRole  String?     @map("requested_role") // 注册申请权限：management | office（审批时映射为正式角色）
  departmentName String?     @map("department_name") // 注册时填写的部门（自由文本，仅作申请信息留存）
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  supplier               Supplier?
  notifications          Notification[]
  supplierEvaluations    SupplierEvaluation[]
  qualificationAlertAcks QualificationAlertAck[]  @relation("UserAlertAcks")
  bidExperts             BidExpert[]
  uploadedFiles          FileAsset[]
  createdProcurements    ProcurementProject[]
  budgetLists            BudgetList[]
  favorites              UserFavorite[]
  auditLogs              AuditLog[]
  supplierApprovals      SupplierApprovalRecord[] @relation("SupplierApprovalReviewer")
  expertProfile          ExpertProfile?
  expertEvaluations      ExpertEvaluation[]       @relation("ExpertEvaluationsReceived")
  expertEvalsGiven       ExpertEvaluation[]       @relation("ExpertEvaluationsGiven")

  // ── 采购中心（从 procurement 项目迁入）──
  attachments                    Attachment[]              @relation("AttachmentUploadedBy")
  attachmentVersions             AttachmentVersion[]       @relation("AttachmentVersionCreatedBy")
  settings                       UserSettings?
  workArrangements               WorkArrangement[]
  workArrangementTemplates       WorkArrangementTemplate[]
  tenderDocumentHistories        TenderDocumentHistory[]
  createdProjects                ProjectManagementItem[]   @relation("ProjectCreatedBy")
  submittedProjects              ProjectManagementItem[]   @relation("ProjectSubmittedBy")
  reviewedProjects               ProjectManagementItem[]   @relation("ProjectReviewedBy")
  teamMemberships                ProjectTeamMember[]
  reviewTasks                    ReviewTask[]
  importBatches                  ImportBatch[]             @relation("ImportBatchUploadedBy")
  passwordChangeRequests         PasswordChangeRequest[]   @relation("PasswordChangeRequestUser")
  approvedPasswordChangeRequests PasswordChangeRequest[]   @relation("PasswordChangeRequestApprovedBy")
  passwordResetRequests          PasswordResetRequest[]    @relation("PasswordResetRequestUser")
  reviewedPasswordResetRequests  PasswordResetRequest[]    @relation("PasswordResetRequestReviewedBy")
  profileChangeRequests          ProfileChangeRequest[]    @relation("ProfileChangeRequestUser")
  reviewedProfileChanges         ProfileChangeRequest[]    @relation("ProfileChangeRequestReviewedBy")
  createdRounds                  ProcurementRound[]        @relation("RoundCreatedBy")
  updatedRounds                  ProcurementRound[]        @relation("RoundUpdatedBy")
  assistantConversations         AssistantConversation[]
  assistantAlerts                AssistantAlert[]
  catalogSubscriptions           CatalogSubscription[]
  catalogVersions                CatalogVersion[]
  catalogInquiries               CatalogInquiry[]
  invitationsCreated             SupplierInvitation[]      @relation("InvitationCreator")

  // ── 工作印记 ──
  userBadges UserBadge[]

  // ── 即时聊天 ──
  chatSent     ChatMessage[] @relation("ChatMessageSender")
  chatReceived ChatMessage[] @relation("ChatMessageReceiver")

  // ── 开标主持人指派：被派到的项目（硬分流 R1）──
  assignedBidProjects BidProject[] @relation("BidProjectAssignedHost")

  @@unique([username, role])
}

// ── 开评标 ──

enum BidStage {
  DOWNLOAD
  SUBMIT
  OPENING
  EVALUATING
  ARCHIVED
  ABORTED
}

enum DecryptStatus {
  PENDING
  RUNNING
  SUCCESS
  DANGER
}

enum ConfirmStatus {
  CONFIRMED
  PENDING
  EXCEPTION
  DISPUTED
}

enum ScoreCategory {
  QUALIFICATION
  RESPONSIVE
  BUSINESS
  TECHNICAL
  PRICE
}

enum ArchiveStatus {
  ARCHIVED
  PENDING_CONFIRM
  NOT_STARTED
}

enum OpeningHallRoomType {
  PUBLIC
  PRIVATE
}

enum OpeningHallSenderRole {
  HOST
  SUPPLIER
  SYSTEM
}

enum OpeningHallMessageType {
  TEXT
}

// ── AI 辅助评标（per-item 版，方案第三章；修正 1.5a 的 procurement 固定 breakdown 版）──
enum AiAnalysisTaskStatus {
  PENDING
  TENDER_PROCESSING
  ANALYZING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum AiBidderStatus {
  PENDING
  OCR_PROCESSING
  OCR_COMPLETED
  EXTRACTING
  EXTRACTED
  CONCORDANCE_CHECKING
  SCORING
  SCORED
  DEVIATION_ANALYZING
  COMPLETED
  FAILED
}

// AI 辅助评标任务（每个 BidProject 进入 EVALUATING 时创建，1:1）
model AiBidAnalysisTask {
  id                      String               @id @default(cuid())
  projectId               String               @unique // ★ 1:1 关联 BidProject（修正 1.5a 的多对一）
  status                  AiAnalysisTaskStatus @default(PENDING)
  tenderText              String? // 招标文件 OCR 文本
  tenderPages             Json?
  requirements            Json? // LLM 提取的招标要求（含 scoringRules）
  scoringCriteriaSnapshot Json? // AI 推断的评分标准快照（不回填 BidScoreItem，见方案 15.8）
  aiProvenance            Json? // P0-D：模型/prompt 版本快照（{ model, ranAt, promptVersions }）
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  completedAt             DateTime?

  project              BidProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bidderResults        AiBidderResult[]
  report               AiBidReport?
  aiConcordanceResults AiConcordanceResult[]

  @@index([status])
  @@map("ai_bid_analysis_tasks")
}

// 投标单位分析结果（每个 BidSupplier 一条，per-item 评分对齐 BidScoreItem）
model AiBidderResult {
  id                   String         @id @default(cuid())
  taskId               String
  bidSupplierId        String // 关联 BidSupplier（BidSupplier.supplierId 可空）
  status               AiBidderStatus @default(PENDING)
  // 文本
  technicalText        String? // 技术标 OCR 文本
  businessText         String? // 商务标 OCR 文本
  // 提取结果
  extractedInfo        Json? // 标书 LLM 提取（审计快照）
  systemInfo           Json? // 系统结构化数据快照（审计快照）
  keyInfo              Json? // 融合后展示对象（权威源 + 一致性标注）
  // per-item 评分（对齐 BidScoreItem，核心）
  scoreItems           Json? // [{scoreItemId, category, name, score, maxScore, reason, evidence, confidence}]
  requirementResponses Json? // 条款-响应定位（matcher 产物）
  categoryTotals       Json? // { QUALIFICATION:{score,max}, RESPONSIVE:{...}, ... }
  starredResponse      Json? // ★ 方案1收尾：★号实质性条款响应核查 { allMet: boolean, unmet?: string[] }
  totalScore           Decimal?       @db.Decimal(5, 2)
  // 判定
  qualificationStatus  String?        @default("pending") // 通过/不通过/待审查
  riskLevel            String?        @default("low")
  riskAnalysis         Json?
  strengths            Json?
  weaknesses           Json?
  overallComment       String?
  deviationAnalysis    Json?
  competitiveAnalysis  Json? // 第二轮横向对比结果
  processedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  task        AiBidAnalysisTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  bidSupplier BidSupplier            @relation(fields: [bidSupplierId], references: [id], onDelete: Cascade)
  concordance AiConcordanceResult?
  reviews     BidRequirementReview[]

  @@unique([taskId, bidSupplierId])
  @@index([taskId])
  @@index([bidSupplierId])
  @@index([status])
  @@map("ai_bidder_results")
}

// 双源一致性校验结果（每 AiBidderResult 一条，1:1）
model AiConcordanceResult {
  id             String   @id @default(cuid())
  taskId         String
  bidderResultId String   @unique // ★ 1:1 关联 AiBidderResult（修正方案 fields:[bidSupplierId] references:[id] 的不成立）
  overallStatus  String // consistent | minor_diff | conflict | insufficient_data
  conflictCount  Int      @default(0)
  warningCount   Int      @default(0)
  checkedFields  Json? // [{field,label,systemValue,docValue,status,severity,note}]
  generatedAt    DateTime @default(now())

  bidder AiBidderResult    @relation(fields: [bidderResultId], references: [id], onDelete: Cascade)
  task   AiBidAnalysisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("ai_concordance_results")
}

// 报告
model AiBidReport {
  id                  String            @id @default(cuid())
  taskId              String            @unique
  summary             Json?
  ranking             Json?
  keyInfoComparison   Json?
  priceAnalysis       Json?
  concordanceSummary  Json? // ★ per-item 版新增（方案第三章）
  strengthsWeaknesses Json?
  scoreItemsDetail    Json? // ★ 方案4：per-item 评分明细（每家按 category 分组，含 reason/strengths/weaknesses/priceAnalysis）
  riskStats           Json?
  highRiskDetails     Json?
  fraudIndicators     Json? // 串通检测
  reviewSuggestions   Json?
  conclusion          String?
  recommendation      Json?
  docxFileId          String?
  pdfFileId           String?
  generatedAt         DateTime?
  task                AiBidAnalysisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("ai_bid_reports")
}

model BidProject {
  id                       String                     @id @default(cuid())
  projectCode              String                     @unique
  name                     String
  procurementMethod        String
  openTime                 DateTime
  deadline                 DateTime
  downloadDeadline         DateTime? // 采购文件下载截止（公告截止时间）；超时不可下载
  sectionNo                String?                   // CTS A-39/40 标段（包）编号（三级映射：PMI=项目、BidProject=招标项目/标段）
  sectionName              String?
  stage                    BidStage                   @default(DOWNLOAD)
  scoreStandardPublishedAt DateTime?
  riskNote                 String?
  budget                   Decimal?                   @db.Decimal(14, 2)
  ceilingPrice             Decimal?                   @db.Decimal(14, 2) // P1: 最高限价/控制价(逐项目可编辑)
  evaluationMethod         String? // P2: 评标办法 comprehensive|lowest_price|ratio|none
  priceFormulaConfig       Json? // P1: { formulaType, K, penaltyRate, noPenaltyRange }
  scope                    String?
  companyId                String?
  companyName              String? // 写时快照（公司改名不扰历史）
  company                  Company?                   @relation(fields: [companyId], references: [id])
  qualification            String?
  directSourcingReason     String? // 直接采购方式选择理由（GB/T 43711 7.2.2.3：直接采购项目公布理由及拟邀请供应商）
  contact                  String?
  qualityRequirement       String? // 质量目标/标准（项目级统一，唱标带出）
  qualificationReviewResult String? // B3（7.2.3.6 资格后审）：评审阶段资格复核结果登记（登记制）
  bondRequired             Boolean                    @default(false) // 是否要求投标保证金
  bondAmount               Decimal?                   @db.Decimal(14, 2) // 保证金金额（仅记录，不严格校验）
  encryptionKeyId          String? // Track C: 项目数据密钥引用
  projectManagementItemId  String? // 多轮采购：所属项目管理项
  frameworkAgreementId     String? // B4（附录 D）：框架协议二阶段项目回链一阶段协议
  gbProcureCode            String? // A1（B.4.3.3）：国标采购项目编码（21 位组合码；不动业务 projectCode 唯一键）
  gbSectionCode            String? // A1（B.4.3.4）：标段（标包/份额）编码（24 位；单标段=采购项目编码+001）
  round                    Int                        @default(1) // 采购轮次（再次采购递增）
  currentRoundNo           Int                        @default(1) // P2c: 当前报价轮次(多轮报价)
  roundMode                String? // P2c: null=单轮 | 'negotiation'=谈判 | 'sealed_auction'=竞价
  leaderCoSigned           Boolean                    @default(false) // C2: 组长末签
  leaderCoSignedAt         DateTime? // C2: 末签时间
  evaluationDeadline       DateTime? // E2: 评标截止时间(超时告警)
  bondReturnedAt           DateTime? // C4（7.5.4.4）：响应担保退还时间（null=未退还；不退的记录见 BidSupervisionLog）
  isExtractionOnly         Boolean                    @default(false) // 自定义抽取影子项目：仅承载专家抽取/通知/确认，不出现在项目管理列表
  // ── 开标主持人指派（R1 硬分流）── null = 未指派（:3007 不可见，:3005 公开池）
  assignedHostUserId       String?
  assignedAt               DateTime?
  assignedByUserId         String? // 操作留痕：指派人 userId
  assignedHostUser         User?                      @relation("BidProjectAssignedHost", fields: [assignedHostUserId], references: [id], onDelete: SetNull)
  suppliers                BidSupplier[]
  openingSession           BidOpeningSession?
  openingRecords           BidOpeningRecord[]
  experts                  BidExpert[]
  scoreItems               BidScoreItem[]
  clarifications           BidClarification[]
  supervisionLogs          BidSupervisionLog[]
  archiveItems             BidArchiveItem[]
  tenderClarifications      TenderClarification[]
  tenderClarificationDocs   TenderClarificationDoc[]
  aiAnalysisTask           AiBidAnalysisTask?
  evaluationResults        BidEvaluationResult[]
  supervisionAnnotations   BidSupervisionAnnotation[]
  supplierSubmissions      SupplierBidSubmission[]
  procurementProject       ProcurementProject?
  projectManagementItem    ProjectManagementItem?     @relation(fields: [projectManagementItemId], references: [id])
  reviews                  BidRequirementReview[]
  bidInvalidBids           BidInvalidBid[]
  expertMemos              ExpertMemo[]
  bidScoreReviews          BidScoreReview[]
  supplierNudge            BidSupplierNudge?
  awardDeliveries          AwardLetterDelivery[]
  bidRounds                BidRound[]
  motions                  BidMotion[]
  expertDisputes           ExpertDispute[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  bidSignPacket            BidSignPacket?

  @@index([stage])
}

/// 开标确认「催促未投递供应商」一次性催促状态（人工/自动共用一次额度）。
/// status: null=未设 | SCHEDULED=已定时待触发 | SENT=已发送。
/// messages: 逐家 AI 通知 { supplierId: { title, body } }；channels: 渠道数组。
/// 定时到点（sendAt）由 SchedulerService 扫描触发；人工发送即置 SENT 并清除定时。
model BidSupplierNudge {
  id           String     @id @default(cuid())
  bidProjectId String     @unique
  bidProject   BidProject @relation(fields: [bidProjectId], references: [id], onDelete: Cascade)
  status       String? // null | SCHEDULED | SENT
  sendAt       DateTime? // 定时触发时间（开标前 24h）
  sentAt       DateTime? // 实际发送时间（人工或自动）
  channels     Json? // string[]  通知渠道
  messages     Json? // Record<supplierId, { title: string; body: string }>
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model BidSupplier {
  id                    String                    @id @default(cuid())
  projectId             String
  supplierId            String?
  supplierName          String
  downloadStatus        String                    @default("待下载")
  lastDownloadAt        DateTime?
  submitStatus          String                    @default("待提交")
  encryptStatus         String                    @default("待校验")
  receiptNo             String?
  decryptStatus         DecryptStatus             @default(PENDING)
  confirmStatus         ConfirmStatus             @default(PENDING)
  project               BidProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier              Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invalidBids           BidInvalidBid[]           @relation("InvalidBidToBidSupplier")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  bidScoreRecords       BidScoreRecord[]
  pointDecisions        BidScorePointDecision[]
  bidderResults         AiBidderResult[]
  supervisionAnnotation BidSupervisionAnnotation?
  bidScoreReviews       BidScoreReview[]
  expertMemos           ExpertMemo[]
  bidQuotes             BidQuote[]
  decryptError          String? // 解密失败原因
  bidValidity           String? // 废标标记：'valid' | 'invalid'
  checkInAt             DateTime? // 开标大厅签到时间
  checkInMeta           String? // 签到环境 JSON 快照：IP / User-Agent（存证）
  lastSeenAt            DateTime? // 大厅在场心跳（节流写入）
  dangerAttribution     String? // BIDDER | PLATFORM | UNKNOWN

  @@unique([projectId, supplierName])
  @@index([supplierId])
}

// ── 采购邀请回执（RSVP）：AI 通知内嵌无登录签名链接，供应商点击确认/拒绝参加，结果记入此表 ──
// token 为 AES-GCM 加密的自包含载荷（sid/pid/iid/供应商名/摘要/过期）+ HMAC 完整性，URL 不泄露任何 id。
model InvitationRsvp {
  id           String    @id @default(cuid())
  token        String    @unique // 加密签名 token（即链接 ?t= 的值）
  invitationId String // 一次通知批次 = 一个 cuid，聚合本批回执
  projectId    String? // 关联招标项目（无项目时为 null，仅记录意向）
  supplierId   String
  supplierName String // 冗余：链接页展示「本回执致：XX 公司」并防误点
  title        String // 链接页标题快照（项目名/采购主题）
  summary      String // 链接页关键信息快照（采购方式/预算/截止/邀请方…，JSON 文本）
  status       String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  note         String? // 供应商回执备注（如「档期冲突」）
  respondedAt  DateTime?
  responseIp   String? // 回执存证
  responseUa   String? // 回执存证
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([invitationId, supplierId]) // 每家每批次一条；改主意走 update
  @@index([supplierId])
  @@index([projectId])
  @@index([token])
}

model BidInvalidBid {
  id          String    @id @default(cuid())
  projectId   String
  supplierId  String
  scoreItemId String? // nullable: dispute/manual 废标无关联评分项
  source      String    @default("passfail") // passfail | dispute | manual — 废标来源
  failCount   Int       @default(0)
  totalCount  Int       @default(0)
  status      String    @default("invalid") // 'invalid' | 'revoked'
  reason      String? // B3: 废标原因（如"通过性审查不通过票过半"）
  actorId     String? // B3: 操作人 userId
  motionId    String? // B3: 关联表决（委员会表决废标时）
  revokedAt   DateTime?
  revokedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   BidProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier  BidSupplier   @relation("InvalidBidToBidSupplier", fields: [supplierId], references: [id], onDelete: Cascade)
  scoreItem BidScoreItem? @relation(fields: [scoreItemId], references: [id], onDelete: SetNull)

  // Unique 由 raw SQL migration 管理：COALESCE(scoreItemId,'') 处理 nullable
  // passfail: unique per (project, supplier, 'passfail', scoreItemId)
  // dispute/manual: unique per (project, supplier, source, '')
  @@index([projectId, supplierId])
}

model BidOpeningSession {
  id                    String     @id @default(cuid())
  projectId             String     @unique
  host                  String
  supervisor            String?
  status                String     @default("待开标")
  decryptWindowStart    DateTime
  decryptWindowEnd      DateTime
  remainingSeconds      Int        @default(0)
  exchangeControl       String     @default("OPEN") // OPEN 允许群聊 | MUTED 仅主持人可发言 | CLOSED 关闭互动
  handoverAssetId       String? // 开标文件包 FileAsset 引用（完成开标·移交后写入）
  handoverAt            DateTime? // 移交时间
  // P1-3①A：开标记录纸面签字（主持人/监督人扫描回传登记，进开标文件包哈希链）
  hostSignScanFileId       String?   // 主持人签字扫描 → FileAsset（category=opening_sign_scan）
  supervisorSignScanFileId String?   // 监督人签字扫描（选填）
  openingSignRegisteredAt  DateTime? // 签字登记闭环时间
  openingSignRegisteredBy  String?   // 登记操作人 userId
  disputeTimeoutMinutes Int? // 异议超时分钟数（null=不限）
  disputedSince         DateTime? // 首个异议提出时间（全部解决后清零）
  activeHostId          String? // 当前操作者 userId（并发检测）
  activeHostName        String? // 当前操作者显示名
  pausedAt              DateTime? // 暂停时刻（正在暂停则为当前时间）
  totalPausedMs         Int        @default(0) // 累计暂停毫秒数（用于补偿解密窗口）
  pauseReason           String? // 暂停原因 (E5)
  project               BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model BidOpeningRecord {
  id              String     @id @default(cuid())
  projectId       String
  supplierName    String
  amount          String
  period          String
  qualityTarget   String
  bondStatus      String
  decryptResult   String
  confirmStatus   String
  // 供应商开标确认闭环：关联投标记录、异议原因、确认/处理时间与结果
  bidSupplierId   String?
  objectionReason String?
  confirmedAt     DateTime?
  handledAt       DateTime?
  handledBy       String?
  handleResult    String?
  project         BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())

  @@unique([projectId, bidSupplierId])
  @@index([bidSupplierId])
  @@index([projectId])
}

model BidExpert {
  id                        String                  @id @default(cuid())
  projectId                 String
  userId                    String
  expertName                String
  major                     String
  isLead                    Boolean                 @default(false)
  expertRole                String                  @default("正选") // 正选 | 候补
  invitationStatus          String                  @default("pending") // pending | confirmed | declined
  signedIn                  Boolean                 @default(false)
  phoneVerified             Boolean                 @default(false)
  avoidanceConfirmed        Boolean                 @default(false)
  aiConsentConfirmed        Boolean                 @default(false)
  aiConsentAt               DateTime?
  confidentialityAgreed     Boolean                 @default(false) // P4: 保密承诺签署
  confidentialityAgreedAt   DateTime? // P4: 签署时间
  disciplineAgreed          Boolean                 @default(false) // P4: 评标纪律确认
  disciplineAgreedAt        DateTime? // P4: 确认时间
  scoreDraft                Json? // G3: 评分草稿(防 localStorage 丢失)
  isPurchaserRepresentative Boolean                 @default(false) // 采购人代表标识（不得担任组长）
  dissentingOpinion         String? // 书面不同意见（null=同意评标结论）
  dissentingReason          String? // 不同意见理由
  conflictedSupplierIds     Json                    @default("[]")
  progress                  Int                     @default(0)
  totalScore                Decimal                 @default("0") @db.Decimal(8, 1)
  reportConfirmed           Boolean                 @default(false)
  reportConfirmedAt         DateTime?
  // RSVP token：免登录确认链接（15分钟有效期），发送通知时生成，超时自动弃权
  rsvpToken                 String?                 @unique
  rsvpExpiresAt             DateTime?
  rsvpRespondedAt           DateTime?
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                   BidProject              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scoreRecords              BidScoreRecord[]
  reviews                   BidRequirementReview[]
  pointDecisions            BidScorePointDecision[]
  expertMemos               ExpertMemo[]
  bidScoreReviews           BidScoreReview[]
  signInIp                  String? // 签到 IP 存证
  signInMeta                Json? // 签到环境快照 { ip, userAgent, timestamp }
  signStatus                SignStatus              @default(PENDING) // 评标签字登记状态（§43 语义）
  signStatusAt              DateTime? // 登记/撤销时间
  signScanFileId            String? // 该专家签字页/不同意见书扫描件 → FileAsset
  signRegisteredBy          String? // 登记人 userId
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model BidScoreItem {
  id              String           @id @default(cuid())
  projectId       String
  category        ScoreCategory
  name            String
  maxScore        Decimal          @default("0") @db.Decimal(5, 1)
  scoringCriteria String? // ★ per-item 新增：评分细则（管理员填 或 AI 推断回填）
  evidenceHint    String? // 评审要点
  criteriaSource  String? // manual | ai_inferred
  project         BidProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scoreRecords    BidScoreRecord[]
  points          BidScorePoint[]
  bidInvalidBids  BidInvalidBid[]
  expertMemos     ExpertMemo[]
  createdAt       DateTime         @default(now())

  @@unique([projectId, name]) // P2：同项目评分项名唯一（防重名致 Σ 校验/模板去重混淆）
  @@index([projectId])
}

model BidScorePoint {
  id                   String                  @id @default(cuid())
  scoreItemId          String
  name                 String
  fullScore            Decimal                 @default("0") @db.Decimal(5, 1)
  seq                  Int                     @default(0)
  evidenceHint         String?
  evidenceSection      String? // 招标文件章节名（AI 提取时记录）
  confidence           Decimal?                @db.Decimal(3, 2) // 0-1 信心分（AI 提取时记录）
  linkedRequirementIds Json? // Phase 1：关联招标条款 requirementId 列表（N:M 指引；映射编辑不受发布锁限制）
  objective            Boolean                 @default(true)
  scoreItem            BidScoreItem            @relation(fields: [scoreItemId], references: [id], onDelete: Cascade)
  decisions            BidScorePointDecision[]
  memos                ExpertMemo[]
  createdAt            DateTime                @default(now())

  @@index([scoreItemId])
}

model BidScoreRecord {
  id          String       @id @default(cuid())
  expertId    String
  scoreItemId String
  supplierId  String
  score       Decimal      @db.Decimal(5, 1)
  passed      Boolean? // 通过性项裁定（资格审查/响应性审查 改通过/不通过制）
  reason      String?
  expert      BidExpert    @relation(fields: [expertId], references: [id], onDelete: Cascade)
  scoreItem   BidScoreItem @relation(fields: [scoreItemId], references: [id], onDelete: Cascade)
  supplier    BidSupplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt // P2：记录最后修改时间（评分可改，需审计轨迹）

  @@unique([expertId, scoreItemId, supplierId])
  @@index([supplierId])
  @@index([scoreItemId, supplierId])
}

/// P5: 评分修订历史 — upsert 覆盖前写入旧值快照,支持回放评分演变过程
model BidScoreRecordHistory {
  id          String   @id @default(cuid())
  recordId    String // 关联 BidScoreRecord.id
  expertId    String
  scoreItemId String
  supplierId  String
  score       Decimal  @db.Decimal(5, 1)
  passed      Boolean?
  reason      String?
  action      String // 'create' | 'update'
  createdAt   DateTime @default(now())

  @@index([recordId])
  @@index([expertId, scoreItemId, supplierId])
}

model BidScorePointDecision {
  id           String        @id @default(cuid())
  expertId     String
  pointId      String
  supplierId   String
  checked      Boolean
  awardedScore Decimal       @db.Decimal(5, 1)
  note         String?
  expert       BidExpert     @relation(fields: [expertId], references: [id], onDelete: Cascade)
  point        BidScorePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  supplier     BidSupplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([expertId, pointId, supplierId])
  @@index([supplierId])
  @@index([expertId, supplierId])
}

/// P5：专家手写/键盘备忘（项目/供应商/评分项级），contentText（OCR 或键盘）+ inkFileId→FileAsset（MinIO 笔迹图）
model ExpertMemo {
  id           String         @id @default(cuid())
  expertId     String
  projectId    String
  supplierId   String?
  scoreItemId  String?
  scorePointId String?
  contentText  String?
  inkFileId    String?
  sourceDevice String? // tablet | desktop
  expert       BidExpert      @relation(fields: [expertId], references: [id], onDelete: Cascade)
  project      BidProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier     BidSupplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  scoreItem    BidScoreItem?  @relation(fields: [scoreItemId], references: [id], onDelete: SetNull)
  scorePoint   BidScorePoint? @relation(fields: [scorePointId], references: [id], onDelete: SetNull)
  inkFile      FileAsset?     @relation(fields: [inkFileId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([expertId, projectId])
  @@index([projectId, supplierId])
  @@index([scorePointId])
}

/// P1-E：评分 delta 数据飞轮（专家分 vs AI 建议分差异，用于采纳率统计 + AI 校准 + 专家反向复核）
model BidScoreDelta {
  id                    String   @id @default(cuid())
  projectId             String
  expertId              String
  supplierId            String
  scoreItemId           String
  aiScore               Decimal  @db.Decimal(5, 1)
  expertScore           Decimal  @db.Decimal(5, 1)
  delta                 Decimal  @db.Decimal(5, 1) // expert − ai
  accepted              Boolean // |delta| ≤ maxScore×10% 视为采纳
  aiConfidence          Decimal? @db.Decimal(3, 2)
  expertReportConfirmed Boolean  @default(false) // 仅统计已确认报告的
  createdAt             DateTime @default(now())

  @@unique([expertId, scoreItemId, supplierId])
  @@index([projectId])
  @@index([expertId])
  @@map("bid_score_deltas")
}

model BidScoreReview {
  id         String    @id @default(cuid())
  expertId   String
  projectId  String
  supplierId String
  status     String    @default("draft") // 'draft' | 'verified'
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  expert   BidExpert   @relation(fields: [expertId], references: [id], onDelete: Cascade)
  project  BidProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier BidSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([expertId, projectId, supplierId])
  @@index([projectId, expertId])
}

model BidClarification {
  id           String     @id @default(cuid())
  projectId    String
  type         String     @default("clarification")
  question     String
  issuer       String
  supplierName String
  supplierId   String?
  status       String     @default("待回复")
  reply        String?
  fileAssetId  String? // 书面交流来函附件（迭代一：书面渠道改造）
  aiSummary    String? // P1-F：LLM 提炼的回复要点（供全体评委速读，不覆盖 reply 原文）
  project      BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier     Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([projectId])
}

/// 全局键值配置（澄清说明文案等平台级文本）
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model BidSupervisionLog {
  id           String     @id @default(cuid())
  projectId    String
  time         DateTime
  role         String
  target       String
  action       String
  result       String
  riskFlag     String     @default("无")
  operatorId   String?
  operatorRole String?
  project      BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([projectId])
}

model BidSupervisionAnnotation {
  id         String   @id @default(cuid())
  projectId  String
  supplierId String   @unique
  status     String   @default("flagged")
  notes      String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  BidProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier BidSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BidArchiveItem {
  id         String        @id @default(cuid())
  projectId  String
  name       String
  ownerRole  String
  status     ArchiveStatus @default(NOT_STARTED)
  hashDigest String?
  fileHashes Json? // P1-14：签字包指纹链持久化（archiveAll 写入，verify/export 重算回读——修复恒 mismatch）
  gbCategory String? // D1（GB/T 43711 4.1.5.1）：对应标准档案类别 key（人工登记项标注）
  retentionUntil DateTime? // D2（4.1.5.2）：归档保存期限（归档日+15 年；期内不得销毁）
  archivedAt DateTime?
  project    BidProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model BidEvaluationResult {
  id           String     @id @default(cuid())
  projectId    String
  supplierId   String
  supplierName String
  totalScore   Decimal    @db.Decimal(6, 2)
  averageScore Decimal    @db.Decimal(6, 2)
  rank         Int
  recommended  Boolean    @default(false)
  disqualified Boolean    @default(false) // 废标（资格审查/响应性审查 改通过/不通过制）
  bidPrice     Decimal?   @db.Decimal(15, 2) // A4: 供应商报价（从开标记录流入，供定标文件使用）
  generatedAt  DateTime   @default(now())
  project      BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, supplierId])
  @@index([projectId, rank])
}

/// A3: 中标通知书送达与签收记录
model AwardLetterDelivery {
  id            String    @id @default(cuid())
  projectId     String
  supplierId    String
  supplierName  String
  letterAssetId String? // 通知书 DOCX 的 FileAsset ID
  content       Json? // 通知书结构化内容（中标单位/金额/项目）
  deliveredAt   DateTime? // 推送到供应商的时间
  receivedAt    DateTime? // 供应商打开时间
  signedAt      DateTime? // 签收确认时间
  signedBy      String? // 签收人 userId
  createdAt     DateTime  @default(now())

  project BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, supplierId])
  @@index([projectId])
}

/// P2c: 报价轮次 — 谈判/竞价多轮报价
model BidRound {
  id                  String    @id @default(cuid())
  projectId           String
  roundNo             Int
  roundType           String // 'negotiation' | 'final_quote' | 'sealed_auction'
  status              String    @default("pending") // pending | open | sealed | published | closed
  deadline            DateTime?
  eligibleSupplierIds String[]  @default([]) // 参与本轮报价的 BidSupplier IDs（空=不限制，legacy 兼容）
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotes  BidQuote[]

  @@unique([projectId, roundNo])
  @@index([projectId])
}

/// P2c: 供应商报价(每轮每供应商一条)
model BidQuote {
  id            String   @id @default(cuid())
  roundId       String
  bidSupplierId String
  quotePrice    Decimal  @db.Decimal(14, 2)
  submittedAt   DateTime @default(now())
  status        String   @default("sealed") // sealed | opened

  round       BidRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  bidSupplier BidSupplier @relation(fields: [bidSupplierId], references: [id], onDelete: Cascade)

  @@unique([roundId, bidSupplierId])
  @@index([roundId])
  @@index([bidSupplierId])
}

/// C1: 委员会动议(异议裁决/废标表决/其他)
model BidMotion {
  id          String     @id @default(cuid())
  projectId   String
  type        String // 'dispute_resolution' | 'invalid_bid' | 'other'
  title       String
  description String?
  status      String     @default("open") // voting | closed（'open' 为 schema 安全默认值，应用层 createMotion 直接写 'voting'）
  result      String? // 'approved' | 'rejected' | 'tie_broken'
  createdBy   String
  createdAt   DateTime   @default(now())
  closedAt    DateTime?
  project     BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  votes       BidVote[]

  @@index([projectId])
}

/// C1: 专家投票
model BidVote {
  id        String    @id @default(cuid())
  motionId  String
  expertId  String
  vote      String // 'approve' | 'reject' | 'abstain'
  reason    String?
  createdAt DateTime  @default(now())
  motion    BidMotion @relation(fields: [motionId], references: [id], onDelete: Cascade)

  @@unique([motionId, expertId])
}

/// D2: 专家异议工单(跨端:专家创建→采购端裁决)
model ExpertDispute {
  id         String     @id @default(cuid())
  projectId  String
  expertId   String
  expertName String
  type       String     @default("scoring") // scoring | procedure | other
  title      String
  content    String
  status     String     @default("open") // open | resolved | rejected
  resolvedBy String?
  resolvedAt DateTime?
  response   String?
  createdAt  DateTime   @default(now())
  project    BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ── C6（GB/T 43711 4.1.4/4.2.2）：供应商异议/投诉工单（登记制）──
// 范围收窄：phase ∈ document 采购文件 | prequalification 资格预审 | result 采购结果；
// 「过程异议」属线上开评标执行域，不在本模型承载。投诉 = escalate 转线下监管处理并登记结果。
model SupplierObjection {
  id             String    @id @default(cuid())
  announcementId String? // 异议对象公告（采购公告/预成交公示等）
  projectId      String? // 关联采购项目内部 ID（无外键——线下项目仅存业务编号）
  projectCode    String? // 业务编号快照（展示/反查）
  supplierId     String
  supplierName   String
  userId         String // 供应商登录账号（答复通知收件人）
  phase          String    @default("result") // document | prequalification | result
  title          String
  content        String
  attachments    Json? // [{name,url}]
  status         String    @default("open") // open 待答复 | answered 已答复 | complaint 已转投诉 | closed 已办结
  answer         String?
  answeredBy     String?
  answeredByName String?
  answeredAt     DateTime?
  escalatedAt    DateTime? // 转投诉时间
  escalationNote String? // 投诉处理记录（转线下监管的登记）
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([supplierId])
  @@index([status])
}

// ── E1（GB/T 43711 第 9 章）：采购质效评价 ──
// 评分卡：质量/效率/合规三维（0-100），权重 SystemConfig 可配（eval_weight_*，默认 40/30/30）。
model ProjectEvaluation {
  id                      String   @id @default(cuid())
  projectManagementItemId String?
  projectId               String? // BidProject
  projectCode             String // 业务编号快照
  projectName             String
  evaluatorId             String
  evaluatorName           String
  qualityScore            Int // 质量维度 0-100
  efficiencyScore         Int // 效率维度 0-100
  complianceScore         Int // 合规维度 0-100
  weightedScore           Int // 加权总分（服务端按权重计算）
  period                  String? // 评价周期标签（如 2026-Q3 / 2026 年度）
  comment                 String?
  createdAt               DateTime @default(now())

  @@index([projectCode])
  @@index([createdAt])
}

// 供应商满意度（9.2 交易和服务对象评价）：成交供应商对采购过程/服务的简表反馈
model SatisfactionFeedback {
  id          String   @id @default(cuid())
  supplierId  String
  supplierName String
  projectCode String
  score       Int // 1-5
  comment     String?
  createdAt   DateTime @default(now())

  @@unique([supplierId, projectCode])
  @@index([projectCode])
}

// ── D2（GB/T 43711 4.1.5.2/A.3.1.3）：档案移交台账 ──
// 归档项目向档案管理部门移交的记录：清单快照（含 hashDigest）+ 双方签收；保存期 15 年自归档起算。
model ArchiveTransfer {
  id                String    @id @default(cuid())
  projectId         String
  transferredByName String // 移交人（采购经办）
  receivedByName    String // 接收方（档案管理部门）
  scope             Json // 移交清单快照 [{itemId, name, hashDigest, retentionUntil}]
  itemCount         Int
  confirmedAt       DateTime? // 接收方确认时间（二次确认制）
  note              String?
  createdAt         DateTime  @default(now())

  @@index([projectId])
}

// ── B3（GB/T 43711 7.2.3）：资格预审（登记制——评审线下完成，结果登记入系统）──
// mode：centralized 集中资格预审（按品类，约定期限内免重复审查）| single 单项资格预审 | post 资格后审（项目字段登记，不用本表）
// method：qualified 合格制 | limited 有限数量制（limitedCount 取前 N）
model Prequalification {
  id                String    @id @default(cuid())
  title             String
  announcementId    String? // 关联 PREQUAL_NOTICE 公告
  projectId         String? // 单项预审挂 BidProject（可空——集中预审独立于项目）
  catalogCategoryId Int? // 集中预审按品类（期限内免重复审查）
  mode              String    @default("single") // centralized | single
  method            String    @default("qualified") // qualified | limited
  limitedCount      Int?
  validUntil        DateTime? // 预审合格有效期（集中预审期内免重复审查）
  status            String    @default("open") // open 接受申请 | reviewing 评审中 | closed 已结束
  result            Json? // 结论快照 {passed, failed, note, decidedAt}
  companyId         String?
  companyName       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  applications PrequalApplication[]

  @@index([catalogCategoryId])
  @@index([status])
}

// 预审申请（供应商提交；结果通知 7.2.3.4：合格发通知书、未通过同步告知）
model PrequalApplication {
  id          String    @id @default(cuid())
  prequalId   String
  supplierId  String
  supplierName String
  userId      String // 通知收件人
  note        String? // 供应商补充说明
  status      String    @default("pending") // pending | passed | failed
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  prequal Prequalification @relation(fields: [prequalId], references: [id], onDelete: Cascade)

  @@unique([prequalId, supplierId])
  @@index([supplierId])
}

// ── B4（GB/T 43711 附录 D）：框架协议采购两阶段（登记制）──
// 一阶段：竞争/资格审查线下或既有流程完成 → 入围结果登记 FaEntry（D.2.6 淘汰比例校验）→ 协议生效；
// 二阶段：从入围集合中二次竞争（线下/既有流程）或按约定规则直接选定 → 登记生成订单合同（Contract.contractType=order）。
// entryMode：closed 封闭式竞争入围（含价格要素）| open 开放式资格审查（无价格，期内可随时申请）
// variant（D.2.2）：supplier_only 定商 | supplier_price 定商定价 | supplier_price_qty 定商定价定量
model FrameworkAgreement {
  id                String    @id @default(cuid())
  faCode            String    @unique
  title             String
  entryMode         String    @default("closed") // closed | open
  variant           String    @default("supplier_price") // supplier_only | supplier_price | supplier_price_qty
  catalogCategoryId Int? // 挂集中采购目录品类
  projectManagementItemId String? // 发起立项的台账项
  validFrom         DateTime
  validUntil        DateTime // 框架协议有效期（D.3.3.4）
  priceRule         Json? // 计价规则/基准价格（定商定价以上必填）
  quotaRule         Json? // 数量范围或占比（定商定价定量必填）
  secondStageRule   String? // 二阶段规则：直接选定条件/二次竞争方式（D.2.4）
  status            String    @default("drafting") // drafting 草拟 | entry 入围登记中 | active 生效 | expired 已到期 | terminated 终止
  eliminationCheck  Json? // D.2.6 淘汰比例校验快照
  changeLog         Json? // 变更记录 [{at, action, note}]（增补/退出/价格调整，D.3.4/D.3.5）
  companyId         String?
  companyName       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  entries FaEntry[]

  @@index([status])
  @@index([catalogCategoryId])
}

// 入围供应商（一阶段产出；封闭式期内不增、开放式可随时申请——D.2.1）
model FaEntry {
  id          String   @id @default(cuid())
  faId        String
  supplierId  String? // 库内供应商（可空——线下供应商登记）
  supplierName String
  shareRatio  Decimal? @db.Decimal(5, 2) // 份额占比 %（定商定价定量可约定）
  status      String   @default("active") // active | supplemented（增补进入）| exited（已退出，D.3.4.2）
  entryAt     DateTime @default(now())
  exitedAt    DateTime?
  note        String?

  fa FrameworkAgreement @relation(fields: [faId], references: [id], onDelete: Cascade)

  @@index([faId])
  @@index([supplierId])
}

// ── C2（GB/T 43711 7.5.4）：采购合同订立 ──
// 状态机：drafting 草拟 → internal_review 内审（审计法务）→ signed 已签署 → performing 履行中
//        → accepted 已验收（C3）| terminated 终止。
// 7.5.4.3 一致性：合同实质性内容应与采购文件、成交供应商响应文件和成交通知书一致——
// 签署前必跑 checkContractConsistency（contract-consistency.ts），结果快照存 consistencyResult。
model Contract {
  id                      String    @id @default(cuid())
  contractCode            String    @unique
  projectId               String? // BidProject 内部 ID（线下成交项目可空，仅存业务编号）
  projectCode             String // 业务编号快照（展示/公告联动）
  projectManagementItemId String? // :3005 项目管理台账关联（详情合同 tab 定位）
  supplierId              String
  supplierName            String
  contractType            String    @default("standard") // standard 标准合同 | order 订单（框架协议二阶段）
  status                  String    @default("drafting") // drafting | internal_review | signed | performing | accepted | terminated
  amount                  Decimal?  @db.Decimal(15, 2)
  signDeadline            DateTime? // 成交通知书约定的签约时限（7.5.4.1）
  signedAt                DateTime?
  keyTerms                Json? // 标的/数量/质量/价款/履行期限/地点与方式/违约责任/争议解决（7.5.4.2）
  draftAssetId            String? // 合同文本草稿 FileAsset（keyTerms 生成 DOCX）
  signedAssetId           String? // 签署版合同扫描件 FileAsset
  consistencyResult       Json? // 一致性校验结果快照（含 issues 列表与校验时间）
  reviewNote              String? // 内审意见（审计法务部，4.1.3.2 审批链留痕）
  companyId               String?
  companyName             String? // 写时快照（公司改名不扰历史）
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  fulfillments ContractFulfillment[]

  @@index([supplierId])
  @@index([status])
  @@index([projectCode])
}

// ── C3（GB/T 43711 7.6）：合同履行台账（交付/付款/验收节点）──
// 7.6.2.1 验收：type=acceptance 的节点完成即登记验收结果，验收报告结构化存 note/proofAssetId。
model ContractFulfillment {
  id           String    @id @default(cuid())
  contractId   String
  type         String // delivery 交付 | payment 付款 | acceptance 验收
  title        String
  dueDate      DateTime?
  doneDate     DateTime?
  amount       Decimal?  @db.Decimal(15, 2)
  status       String    @default("pending") // pending 待办 | done 已完成 | exception 异常
  proofAssetId String? // 履约证明/验收报告附件（供应商上传或采购人登记）
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, type])
}

// ── 专家管理 ──

model ExpertProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  specialty          String // 专业领域（水利工程/机电设备/造价咨询/...）
  title              String? // 职称（教授级高工/高工/...）
  employer           String? // 工作单位（用于供应商回避校验）
  phone              String?
  idNumber           String? // 身份证号
  ethnicity          String? // 民族
  education          String? // 学历（博士/硕士/本科/大专/...）
  licenseNo          String? // 执业资格证号
  availability       String    @default("可用") // 可用 / 占用 / 停用
  // CTS A-218/222 专家库状态机（入库审核层，与 availability 占用层分离）
  entryStatus        String    @default("ACTIVE") // PENDING=待审核 | ACTIVE=在库 | SUSPENDED=暂停 | RETIRED=退库
  statusNote         String? // 暂停/退库事由
  verifiedById       String? // 审核入库责任人（A-218 信息完整性留痕）
  verifiedAt         DateTime?
  notes              String?
  retiredAt          DateTime? // Track D: 退库时间（人工确认后写入）
  retireReason       String? // Track D: 退库原因
  retireIgnoredAt    DateTime? // 管理员标记忽略退库预警（next scan 自动重置超过 90 天的标记）
  contactConfirmedAt DateTime? // 首次登录联系方式确认时间（null = 未确认，需弹窗提醒）
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([specialty])
  @@index([availability])
}

enum ExpertLevel {
  A // 优秀
  B // 良好
  C // 合格
  D // 待改进
  E // 不合格
}

model ExpertEvaluation {
  id              String      @id @default(cuid())
  expertUserId    String
  projectId       String?
  evaluatorId     String
  attendanceGrade ExpertLevel // 出勤纪律等级
  qualityGrade    ExpertLevel // 评审质量等级（权重 50%）
  disciplineGrade ExpertLevel // 廉洁纪律等级（权重 30%）
  overallGrade    ExpertLevel // 综合等级 = weighted(质量×0.5 + 纪律×0.3 + 出勤×0.2)
  comment         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  expertUser User @relation("ExpertEvaluationsReceived", fields: [expertUserId], references: [id], onDelete: Cascade)
  evaluator  User @relation("ExpertEvaluationsGiven", fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@index([expertUserId])
  @@index([evaluatorId])
}

// ── 供应商管理 ──

enum SupplierStatus {
  PENDING // 待审核
  RETURNED // 退回补正
  APPROVED // 审核通过/已入库
  REJECTED // 审核不通过
  DISABLED // 停用
  BLACKLIST // 黑名单
}

enum InvitationStatus {
  ACTIVE // 未使用且未过期
  USED // 已使用
  EXPIRED // 已过期
  REVOKED // 已作废
}

enum ChangeStatus {
  PENDING // 待审核
  APPROVED // 已通过
  REJECTED // 已拒绝
}

model Supplier {
  id                 String         @id @default(cuid())
  userId             String         @unique
  supplierNo         String         @unique // 供应商编号（SUP-000001，由 PG 序列 supplier_no_seq 生成）
  name               String
  normalizedName     String
  creditCode         String?        @unique
  subjectCode        String?        // A1（B.4.2）：国标交易主体编码（B+统一社会信用代码；无信用代码走 C 类平台赋码）
  enterpriseType     String
  legalPerson        String
  legalPersonIdCard  String? // 法定代表人身份证号（注册必填，存量数据可空）
  legalPersonPhone   String? // 法人联系电话
  registeredAddress  String
  detailedAddress    String? // 详细地址
  businessScope      String
  // ── 注册 2.0 扩展字段（存量数据可空）──
  logoUrl            String? // 公司 logo
  organizationCode   String? // 机构代码
  country            String? // 国别
  region             String? // 所属行政区域
  registeredCapital  String? // 注册资本
  industry           String? // 所属行业
  companyEmail       String? // 公司邮箱
  companyWebsite     String? // 公司官网地址
  status             SupplierStatus @default(PENDING)
  classificationId   String?
  rejectReason       String?
  returnReason       String?
  disableReason      String? // 停用/拉黑原因（B6：替代 returnReason 的语义错用）
  eliminatedAt       DateTime? // 淘汰确认时间（B12：非空=经淘汰流程，区分手动停用）
  sm2PublicKey       String? // SM2 公钥（04 开头 hex，用于验证投标签名）
  // ── 临时供应商（凭邀请码注册，有效期由邀请码绑定）──
  isTemporary        Boolean        @default(false)
  temporaryExpiresAt DateTime?
  tags               String[]       @default([])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classification      SupplierClassification?      @relation(fields: [classificationId], references: [id])
  classificationLinks SupplierClassificationLink[]
  contacts            SupplierContact[]
  qualifications      SupplierQualification[]
  bankAccounts        SupplierBankAccount[]
  performances        SupplierPerformance[]
  evaluations         SupplierEvaluation[]
  changeRecords       SupplierChangeRecord[]
  tenderClarifications TenderClarification[]
  clarificationReceipts TenderClarificationReceipt[]
  bidSuppliers        BidSupplier[]
  bidSubmissions      SupplierBidSubmission[]
  bidDocumentAccesses BidDocumentAccess[]
  catalogApplications SupplierCatalogApplication[]
  catalogSupplies     CatalogSupplier[]
  alertAcks           QualificationAlertAck[]      @relation("SupplierAlertAcks")
  clarifications      BidClarification[]
  contractPrices      ContractPrice[]
  invitation          SupplierInvitation[]         @relation("InvitationUsedBy")
  certs               SupplierCert[]

  // ── 采购中心关联 ──
  awardedRounds  ProcurementRound[] @relation("AwardedSupplier")
  participations RoundParticipant[]

  approvalRecords SupplierApprovalRecord[]

  @@index([status])
  @@index([creditCode])
}

// ── 供应商审核历史（不可变留痕）──
// 记录每次审核操作：申请完整快照、验证人、是否同意、时间、理由。不可删减、不可修改。
model SupplierApprovalRecord {
  id             String   @id @default(cuid())
  supplierId     String
  action         String // APPROVED / REJECTED / RETURNED
  reviewerUserId String? // 验证/审核人员
  reason         String? // 同意/拒绝/退回的理由
  snapshot       Json // 审核时点申请完整信息快照（企业/法人/联系人/资质等）
  createdAt      DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  reviewer User?    @relation("SupplierApprovalReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([supplierId, createdAt])
}

// ── 临时供应商邀请码（采购端生成，有效期 30/180/360 天）──
model SupplierInvitation {
  id              String           @id @default(cuid())
  code            String           @unique // 8 位大写字母+数字，公开可填
  validityDays    Int // 30 / 180 / 360
  status          InvitationStatus @default(ACTIVE)
  note            String? // 备注（如「XX项目临时供应商」）
  boundCreditCode String? // R-3：绑定指定信用代码（仅该企业可用，防码泄漏任意注册）
  createdById     String // 创建人（procurement_staff）
  createdAt       DateTime         @default(now())
  expiresAt       DateTime // createdAt + validityDays
  usedById        String? // 使用者 Supplier.id（非唯一：一个供应商可通过多个邀请码续期）
  usedAt          DateTime?
  revokedAt       DateTime?
  revokedById     String?

  createdBy User      @relation("InvitationCreator", fields: [createdById], references: [id])
  usedBy    Supplier? @relation("InvitationUsedBy", fields: [usedById], references: [id])

  @@index([status])
  @@index([createdById])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  gender     String? // 性别（男/女）
  phone      String
  idCard     String? // 联系人身份证号（注册必填，存量数据可空）
  email      String?
  position   String? // 部门职务
  personnelType String? // CTS A-216 人员类别：法人代表/项目经理/技术负责人/质量安全负责人/持证人员/普通联系人
  certTitle  String? // 执业资格/证书（如：一级建造师(水利水电)）
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// ── 供应商银行账户（注册第 3 部分，可多项）──
model SupplierBankAccount {
  id          String   @id @default(cuid())
  supplierId  String
  accountName String // 户名
  bankName    String // 开户银行
  bankBranch  String? // 开户支行
  accountNo   String // 银行账号
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// ── 供应商主体业绩（注册第 5 部分，可多项，每项须上传证明材料）──
model SupplierPerformance {
  id             String    @id @default(cuid())
  supplierId     String
  projectName    String // 项目名称
  recordType     String    @default("performance") // CTS A-213: performance=业绩 | reward=奖励 | punishment=惩戒
  recordNote     String? // 奖惩事由/文号
  effectiveDate  DateTime? // 奖惩生效日期
  clientName     String? // 业主/客户名称
  contractAmount String? // 合同金额
  signDate       DateTime? // 签订日期
  description    String? // 业绩描述
  proofFiles     Json // 证明材料 [{name,url}]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierQualification {
  id         String    @id @default(cuid())
  supplierId String
  type       String
  name       String
  fileUrl     String
  attachments Json? // 附加材料 [{name,url}]（支持多项上传）
  validFrom   DateTime?
  validTo     DateTime?
  status      String    @default("有效")
  createdAt   DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  supplier Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  acks     QualificationAlertAck[] @relation("QualAlertAcks")

  @@index([supplierId])
  @@index([validTo])
}

// B11：资质到期预警「已处理」确认记录，替代前端 sessionStorage（换浏览器/换设备不丢）
model QualificationAlertAck {
  id              String   @id @default(cuid())
  qualificationId String
  userId          String
  supplierId      String
  createdAt       DateTime @default(now())

  qualification SupplierQualification @relation("QualAlertAcks", fields: [qualificationId], references: [id], onDelete: Cascade)
  user          User                  @relation("UserAlertAcks", fields: [userId], references: [id], onDelete: Restrict)
  supplier      Supplier              @relation("SupplierAlertAcks", fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([qualificationId, userId])
  @@index([userId])
}

// #13 选取历史落库：替代多实例不安全的 JSON 文件存储（跨进程 read-modify-write 会丢记录/分裂）。
model SupplierSelectionHistory {
  id                  String   @id @default(cuid())
  requirement         String
  classificationId    String?
  classificationName  String?
  resultSummary       String
  recommendationCount Int
  candidatePool       Int
  shortlistedIds      String[]
  recommendations     Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([createdAt])
}

model SupplierClassification {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  suppliers Supplier[]
  links     SupplierClassificationLink[]
}

model SupplierClassificationLink {
  supplierId       String
  classificationId String
  assignedAt       DateTime @default(now())

  supplier       Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  classification SupplierClassification @relation(fields: [classificationId], references: [id], onDelete: Cascade)

  @@id([supplierId, classificationId])
}

model SupplierEvaluation {
  id                  String      @id @default(cuid())
  supplierId          String
  projectId           String?
  evaluatorId         String
  completenessGrade   ExpertLevel // 资料完整性等级（权重 20%）
  responsivenessGrade ExpertLevel // 文件响应等级（权重 30%）
  cooperationGrade    ExpertLevel // 配合协作等级（权重 20%）
  complianceGrade     ExpertLevel // 合规守信等级（权重 20%）
  comprehensiveGrade  ExpertLevel // 综合评价等级（权重 10%）
  finalGrade          ExpertLevel // 综合等级 = weighted average
  comment             String?
  evidence            Json?
  // A4（4.1.1.8）：评价来源——procurement=采购过程评价（原口径）| contract=合同履约验收后评价（C3）
  evaluationSource    String      @default("procurement")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evaluator User     @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([evaluatorId])
}

model SupplierChangeRecord {
  id           String       @id @default(cuid())
  supplierId   String
  fieldName    String
  fieldLabel   String
  oldValue     String?
  newValue     String?
  reason       String?
  status       ChangeStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([status])
}

model SupplierDocument {
  id         String   @id @default(cuid())
  supplierId String
  type       String   @default("other")
  name       String
  fileUrl    String
  fileSize   Int?
  note       String?
  uploaderId String
  createdAt  DateTime @default(now())

  @@index([supplierId])
}

model SupplierFavorite {
  id         String   @id @default(cuid())
  supplierId String
  userId     String
  createdAt  DateTime @default(now())

  @@unique([supplierId, userId])
  @@index([userId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  content    String
  isRead     Boolean   @default(false)
  resolvedAt DateTime?
  link       String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, type, resolvedAt])
}

// ── 通知投递日志（Track A：多渠道投递记录） ──

model NotificationDeliveryLog {
  id             String   @id @default(cuid())
  notificationId String? // 关联站内信 id（in-app 渠道写入后回填）
  userId         String
  channel        String // in_app | email | sms
  status         String // sent | failed | skipped
  error          String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([userId, channel, createdAt])
}

// ── 公告管理 ──

enum AnnouncementType {
  BID_NOTICE // 招标公告
  ADDENDUM // 补遗/澄清公告（GB/T 43711 7.2.6：采购文件澄清修改告知潜在供应商）
  PREQUAL_NOTICE // 资格预审公告（7.2.3：集中/单项资格预审，供应商提交申请）
  PRE_WIN_NOTICE // 预成交公示（GB/T 43711 7.5.2.2：公示期 3 日，期满无异议后发布成交公告）
  WIN_NOTICE // 成交公告（原"中标公示"语义升级为两段式第二段）
  CONTRACT_NOTICE // 合同公告（7.5.4.5 宜公开：名称/编码、当事人、价款、签约时间、期限）
  PERFORMANCE_NOTICE // 合同履行结果公告（7.6.2.2）
  POLICY // 政策法规
  PLATFORM // 平台通知
  CLARIFY_NOTICE // 澄清与修改公告（B-014 醒目公告，isTop）
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Announcement {
  id                 String             @id @default(cuid())
  title              String
  content            String
  aiSummary          String?
  type               AnnouncementType   @default(BID_NOTICE)
  status             AnnouncementStatus @default(DRAFT)
  summary            String?
  publishDate        DateTime?
  publicityEnd       DateTime? // A1: 公示截止时间（WIN_NOTICE 发布时自动设为 publishDate + 3 天）
  isTop              Boolean            @default(false)
  viewCount          Int                @default(0)
  relatedProjectCode String?
  authorId           String?
  companyId          String?
  companyName        String? // 写时快照（公司改名不扰历史）
  company            Company?           @relation(fields: [companyId], references: [id])
  metadata           Json? // 各类型结构化字段（招标/中标/政策/平台）
  // A2（表 B.1/B.3）：交易数据集公开范围 + 功能属性分类（默认按公告类型回填，可覆盖）
  dataClass          String? // public_mandatory 应公开 | public_voluntary 宜公开 | public_conditional 可公开 | confidential 应保密
  dataDomain         String? // trade 交易过程 | supervision 监管 | rights 权益保护
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  attachments AnnouncementAttachment[]
  bidDocument BidDocument?

  @@index([type])
  @@index([status])
  @@index([publishDate])
}

// ── 公告附件（普通，公开可下载）──

model AnnouncementAttachment {
  id             String   @id @default(cuid())
  announcementId String
  fileAssetId    String
  title          String
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset    @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

// ── 招标文件（加密 + 受控分发）──

model BidDocument {
  id             String   @id @default(cuid())
  announcementId String   @unique
  fileAssetId    String
  title          String
  accessScope    String   @default("OPEN") // OPEN | DESIGNATED | INVITED
  requirePayment Boolean  @default(false)
  price          Decimal? @db.Decimal(12, 2)
  decryptKey     String // AES-256-GCM 密钥:iv:authTag (hex)
  bidProjectId   String? // INVITED 时关联招标项目
  addendumNo     Int      @default(0) // C5（7.2.6）：补遗序号——每发布一条补遗公告 +1，供应商侧显示"补遗 N 次"
  downloadCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  announcement Announcement        @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset           @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  accesses     BidDocumentAccess[]

  @@index([accessScope])
}

model BidDocumentAccess {
  id             String    @id @default(cuid())
  documentId     String
  supplierId     String
  eligible       Boolean   @default(true) // DESIGNATED 白名单
  paid           Boolean   @default(false)
  paidAt         DateTime?
  paymentRef     String? // 付款凭证/流水号
  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  document BidDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  supplier Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([documentId, supplierId])
  @@index([supplierId])
}

// ── 供应商标书提交 ──

model SupplierBidSubmission {
  id                   String    @id @default(cuid())
  supplierId           String
  projectId            String
  bidPrice             String?
  deliveryPeriod       String?
  qualityCommitment    String? // 供应商投递的质量承诺（2026-08-17）：唱标「质量目标」改自此取，缺失回退项目 qualityRequirement
  technicalFile        String?
  businessFile         String?
  coverLetter          String?
  // 可验证、可授权的真实文件引用（指向 FileAsset.id）；保留旧字符串字段以兼容存量数据
  technicalFileAssetId String?
  businessFileAssetId  String?
  coverLetterAssetId   String?
  bidBondAssetId       String? // 投标保证金缴纳凭证 → FileAsset.id（程序性文件，不加密）
  // Layer B：新提交的投标文件 AES-256-GCM 加密封存密钥（key:iv:authTag hex）。legacy 存量数据为 null。
  technicalSealedKey   String?
  businessSealedKey    String?
  coverLetterSealedKey String?
  // SM2 抗抵赖签名字段（可选，兼容存量数据）
  fileHash             String? // 投标文件整体 SHA-256（签名前计算）
  signature            String? // SM2 签名值 hex
  signedAt             DateTime? // 签名时间
  // ── 双信封 v2（dual-envelope）──
  envelope          Json?    // dual-v2 信封（version/certSn/adminCertId/files/sealedFields/fieldsCommit）
  envelopeVersion   String?  // 'dual-v2' | null(旧轨)
  hostDecryptAuthorized Boolean @default(false) // P1-1：旧轨投递时投标人勾选「同意平台在开标环节代解密」的授权记录（办法第30条留痕；新轨供应商自解无需）
  decryptedPrice    String?  // 解密上传后经 fieldsCommit 验证的报价
  outerDecryptedAt  DateTime?
  packageFetchedAt  DateTime?
  innerAssets       Json?    // {role: assetId}——C_inner 归属链（§5.4a）
  decryptedAssets   Json?    // {role: assetId}——解密明文归属链（§5.4a）
  status               String    @default("draft") // draft, submitted, withdrawn
  submittedAt          DateTime?
  serverSubmittedAt    DateTime? // 服务端权威提交时间（审计信任锚点）
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  supplier Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  project  BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([supplierId, projectId])
  @@index([supplierId])
  @@index([projectId])
  @@index([technicalFileAssetId])
  @@index([businessFileAssetId])
  @@index([coverLetterAssetId])
  @@index([bidBondAssetId])
}

// ── 文件资产 ──

model FileAsset {
  id              String   @id @default(cuid())
  key             String   @unique
  originalName    String
  mimeType        String
  // A2（表 B.1）：按类目默认分级（bid 文件=conditional、递交件=confidential、公告附件=mandatory…）
  dataClass       String?
  dataDomain      String?
  size            Int
  sha256          String
  category        String
  uploaderId      String?
  encrypted       Boolean  @default(false) // Track C: 标书静态加密标记
  encryptionKeyId String? // Track C: 项目数据密钥引用
  iv              String? // Track C: AES-GCM iv (base64)
  authTag         String? // Track C: AES-GCM authTag (base64)
  sealedPath      String? // Layer B: 密文存储路径（不覆盖原明文）
  clientEncrypted Boolean  @default(false) // E2EE: 客户端加密标记（上传时已是密文）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  uploader    User?        @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  expertMemos ExpertMemo[]
  archiveMeta ArchiveMetadata?

  announcementAttachments AnnouncementAttachment[]
  bidDocuments            BidDocument[]
  chatMessages            ChatMessage[]

  @@index([category])
  @@index([uploaderId])
}

/// P1-12：操作日志月分区归档清单（archive-before-drop）——办法第42条≥15年留存的凭据+幂等锚点。
/// dropExpiredPartitions 先导出分区到 MinIO（gzip JSON-lines）写本清单，再 DROP；导出失败不 DROP（数据保留）。
model OperationLogArchive {
  id         String   @id @default(cuid())
  month      String   @unique // 分区月 YYYY_MM
  rowCount   Int
  objectKey  String   @unique // MinIO: operation-log-archive/<yyyy_mm>.jsonl.gz（空分区为空串）
  sha256     String // gzip 对象 SHA-256（空分区为空串）
  sizeBytes  Int
  archivedAt DateTime @default(now())

  @@index([archivedAt])
}

/// 未解密投标文件备份：提交时即固化的加密态副本（自包含证据包），用于争议核验。
/// 不设外键级联——备份需独立长存，即使提交记录撤回/删除也保留。
model BidFileBackup {
  id               String   @id @default(cuid())
  projectId        String
  supplierId       String
  fileAssetId      String
  fileRole         String // technical | business | coverLetter | bond(dual-v2 新轨)
  backupKey        String   @unique // MinIO: sealed-backup/{pid}/{sid}/{role}/{basename}
  sealedPath       String // 本备份所镜像的 sealed 对象键（核验时直接读取）
  wrappedDek       String // KMS 包裹的 DEK（密文，需 KMS_SECRET 解包）
  ciphertextSha256 String // sha256(密文) — 完整性自证锚点
  plaintextSha256  String? // 复用 FileAsset.sha256（明文哈希）
  size             Int
  receiptNo        String? // 回执号 TB-yyyymmdd-NNN
  backupSource     String   @default("submission") // submission | reconcile
  cryptoVersion    String   @default("envelope-v1") // AES-256-GCM + wrapKey(salt water-erp-envelope-salt-v1)
  submittedAt      DateTime
  createdAt        DateTime @default(now())

  @@unique([supplierId, projectId, fileRole])
  @@index([projectId, supplierId])
}

// ── 开标大厅（迭代一：实时文字地基）──

model OpeningHallMessage {
  id          String                 @id @default(cuid())
  projectId   String
  roomType    OpeningHallRoomType
  supplierId  String? // PRIVATE 时为 Supplier.id；PUBLIC 为 null
  senderId    String
  senderRole  OpeningHallSenderRole
  senderName  String // 发送时姓名快照（存证不依赖日后改名）
  type        OpeningHallMessageType @default(TEXT)
  content     String
  fileAssetId String? // 预留：迭代二短语音
  createdAt   DateTime               @default(now())

  @@index([projectId, roomType, supplierId, createdAt])
  @@index([projectId, createdAt])
}

model OpeningHallReadCursor {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  roomKey    String // "public"（公聊）| "supplier:<supplierId>"（私聊）
  lastReadAt DateTime @default(now()) @updatedAt

  @@unique([projectId, userId, roomKey])
}

// ── 即时聊天 ──

model ChatMessage {
  id          String    @id @default(cuid())
  senderId    String
  receiverId  String
  type        String    @default("text") // text | image | file
  content     String // text: 正文；image/file: 文件名
  fileAssetId String?
  fileUrl     String? // 缓存 /api/upload/files/:id，避免前端再查
  fileMime    String?
  fileSize    Int?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User       @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User       @relation("ChatMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  fileAsset FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
}

// ── 采购管理 ──

enum ProcurementStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  BIDDING
  CONTRACTED
  CLOSED
}

model ProcurementProject {
  id                String             @id @default(cuid())
  title             String
  projectCode       String             @unique
  description       String?
  budget            Decimal?           @db.Decimal(12, 2)
  procurementType   String // 货物/工程/服务
  procurementMethod String // 公开招标/邀请招标/竞争性谈判/单一来源
  status            ProcurementStatus  @default(DRAFT)
  rejectReason      String?
  departmentId      String?
  creatorId         String?
  companyId         String?
  companyName       String? // 写时快照（公司改名不扰历史）
  company           Company?           @relation(fields: [companyId], references: [id])
  bidProjectId      String?            @unique // 关联的招标项目
  bidProject        BidProject?        @relation(fields: [bidProjectId], references: [id])
  department        Department?        @relation(fields: [departmentId], references: [id])
  creator           User?              @relation(fields: [creatorId], references: [id])
  budgetList        BudgetList?
  rounds            ProcurementRound[] // 采购中心台账轮次
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
}

// ── 品类树节点 ──

model CatalogCategory {
  id        Int               @id @default(autoincrement())
  name      String
  code      String?           @unique
  parentId  Int?
  parent    CatalogCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  CatalogCategory[] @relation("CategoryHierarchy")
  sortOrder Int               @default(0)
  status    String            @default("ACTIVE") // ACTIVE | INACTIVE
  isLeaf    Boolean           @default(false)
  icon      String?
  // ── B2（GB/T 43711 4.1.1.3/4.1.3.2）：分类分级集中采购目录清单 ──
  centralizedLevel     String?          @default("centralized") // centralized 集中采购 | decentralized 分散采购（null=未分级，按集中处理）
  centralizedThreshold Decimal?         @db.Decimal(14, 2) // 分级金额阈值（元）：预算 ≥ 阈值走集中采购
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  attributeTemplates CategoryAttributeTemplate[]
  catalogItems       CatalogItem[]
  alertRules         PriceAlertRule[]

  @@index([parentId])
  @@index([code])
}

// ── 品类属性模板 ──

model CategoryAttributeTemplate {
  id         Int             @id @default(autoincrement())
  categoryId Int
  category   CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  fieldKey   String
  fieldType  String // TEXT | NUMBER | SELECT | DATE | BOOLEAN
  required   Boolean         @default(false)
  options    Json?
  unit       String?
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())

  itemAttributes CatalogItemAttribute[]

  @@unique([categoryId, fieldKey])
  @@index([categoryId])
}

// ── 目录项属性值 (EAV) ──

model CatalogItemAttribute {
  id            Int                       @id @default(autoincrement())
  catalogItemId String
  catalogItem   CatalogItem               @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  templateId    Int
  template      CategoryAttributeTemplate @relation(fields: [templateId], references: [id])
  value         String

  @@unique([catalogItemId, templateId])
  @@index([catalogItemId])
}

// ── 目录版本快照 ──

model CatalogVersion {
  id          Int      @id @default(autoincrement())
  name        String
  version     String
  effectiveAt DateTime
  status      String   @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  description String?
  snapshot    Json
  createdAt   DateTime @default(now())
  createdBy   String
  user        User     @relation(fields: [createdBy], references: [id])

  @@index([status])
}

// ── 批量询价单 ──

model CatalogInquiry {
  id          Int       @id @default(autoincrement())
  title       String
  status      String    @default("DRAFT") // DRAFT | SENT | CLOSED
  items       Json // [{ catalogItemId, spec, qty }]
  supplierIds String[]
  deadlineAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  createdBy   String
  user        User      @relation(fields: [createdBy], references: [id])

  @@index([status])
}

// ── 框架合同价格 ──

model ContractPrice {
  id            Int         @id @default(autoincrement())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  contractNo    String
  agreedPrice   Float
  validFrom     DateTime
  validUntil    DateTime
  status        String      @default("ACTIVE") // ACTIVE | EXPIRED | TERMINATED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([catalogItemId])
  @@index([supplierId])
  @@index([validUntil])
}

// ── 目录项关联 ──

model CatalogItemRelation {
  id            Int         @id @default(autoincrement())
  catalogItemId String
  catalogItem   CatalogItem @relation("ItemRelations", fields: [catalogItemId], references: [id], onDelete: Cascade)
  relatedItemId String
  relatedItem   CatalogItem @relation("RelatedItems", fields: [relatedItemId], references: [id], onDelete: Cascade)
  relationType  String // SUBSTITUTE | COMPLEMENT | SIMILAR
  createdAt     DateTime    @default(now())

  @@unique([catalogItemId, relatedItemId, relationType])
}

// ── 价格预警规则 ──

model PriceAlertRule {
  id          Int              @id @default(autoincrement())
  name        String
  categoryId  Int?
  category    CatalogCategory? @relation(fields: [categoryId], references: [id])
  alertType   String // PRICE_SURGE | PRICE_DROP | EXPIRING | DEVIATION
  threshold   Float
  enabled     Boolean          @default(true)
  notifyRoles String[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  alerts      PriceAlert[]

  @@index([categoryId])
}

// ── 价格预警记录 ──

model PriceAlert {
  id            Int            @id @default(autoincrement())
  ruleId        Int
  rule          PriceAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   CatalogItem    @relation(fields: [catalogItemId], references: [id])
  alertType     String
  message       String
  triggerValue  Float
  isRead        Boolean        @default(false)
  isResolved    Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@index([catalogItemId])
  @@index([isRead, isResolved])
}

// ── 电子商城采购目录 ──

model CatalogItem {
  id                  String                       @id @default(cuid())
  code                String                       @unique
  name                String
  specification       String
  category            String
  group               String
  categoryId          Int?
  categoryRel         CatalogCategory?             @relation(fields: [categoryId], references: [id])
  unit                String
  referencePrice      Decimal                      @db.Decimal(12, 2)
  priceMin            Decimal                      @db.Decimal(12, 2)
  priceMax            Decimal                      @db.Decimal(12, 2)
  lastDealPrice       Decimal                      @db.Decimal(12, 2)
  averagePrice        Decimal                      @db.Decimal(12, 2)
  supplier            String
  supplierType        String
  priceSource         String
  region              String
  taxIncluded         Boolean                      @default(true)
  freightIncluded     Boolean                      @default(false)
  changeRate          Decimal                      @db.Decimal(5, 2)
  minOrder            String
  remark              String?
  status              String                       @default("有效")
  lifecycleStage      String                       @default("有效") // 草稿|待审核|有效|价格异常|即将过期|已下架|已归档
  nationalStandard    String? // GB/T 1499.2-2018
  validUntil          DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  budgetItems         BudgetItem[]
  priceHistory        PriceHistory[]
  favoritedBy         UserFavorite[]
  catalogApplications SupplierCatalogApplication[]
  catalogSuppliers    CatalogSupplier[]
  attributes          CatalogItemAttribute[]
  priceAlerts         PriceAlert[]
  relations           CatalogItemRelation[]        @relation("ItemRelations")
  relatedTo           CatalogItemRelation[]        @relation("RelatedItems")
  contractPrices      ContractPrice[]
  attachments         CatalogItemAttachment[]
  subscriptions       CatalogSubscription[]

  @@index([category])
  @@index([group])
  @@index([categoryId])
  @@index([status])
}

// ── 目录项附件 ──

model CatalogItemAttachment {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  fileType      String // IMAGE | PDF | CERTIFICATE | OTHER
  fileSize      Int
  uploadedAt    DateTime    @default(now())

  @@index([catalogItemId])
}

// ── 搜索日志（搜了没有的词）──

model CatalogSearchLog {
  id        Int      @id @default(autoincrement())
  keyword   String
  userId    String?
  createdAt DateTime @default(now())

  @@index([keyword])
  @@index([createdAt])
}

// ── 目录变更订阅 ──

model CatalogSubscription {
  id            Int         @id @default(autoincrement())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, catalogItemId])
}

// ── 电子商城预算清单 ──

model BudgetList {
  id                   String              @id @default(cuid())
  name                 String
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                BudgetItem[]
  procurementProjectId String?             @unique
  procurementProject   ProcurementProject? @relation(fields: [procurementProjectId], references: [id], onDelete: SetNull)
  totalAmount          Decimal?            @db.Decimal(14, 2)
  itemCount            Int                 @default(0)
  status               String              @default("ACTIVE") // ACTIVE | CONVERTED | ARCHIVED
  remark               String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

model BudgetItem {
  id             String       @id @default(cuid())
  budgetListId   String
  budgetList     BudgetList   @relation(fields: [budgetListId], references: [id], onDelete: Cascade)
  catalogItemId  String?
  catalogItem    CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  code           String
  name           String
  specification  String?
  unit           String
  referencePrice Decimal      @db.Decimal(12, 2)
  qty            Decimal      @db.Decimal(12, 2)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([budgetListId])
  @@index([catalogItemId])
}

// ── 采购目录价格历史 ──

model PriceHistory {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  price         Decimal     @db.Decimal(12, 2)
  recordedAt    DateTime
  note          String?
  createdAt     DateTime    @default(now())

  @@index([catalogItemId, recordedAt])
}

// ── 采购目录收藏 ──

model UserFavorite {
  userId        String
  catalogItemId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([userId, catalogItemId])
  @@index([userId])
  @@index([catalogItemId])
}

// ── 供应商目录/供货申请（新增品类 / 加入供货 / 改报价，含议价回环）──

model SupplierCatalogApplication {
  id         String @id @default(cuid())
  supplierId String
  type       String // NEW_ITEM(新增品类) | JOIN_EXISTING(加入已有供货) | UPDATE_QUOTE(改报价)

  // JOIN_EXISTING / UPDATE_QUOTE 指向已有目录条目
  catalogItemId String?

  // NEW_ITEM 拟增物资信息
  proposedName     String?
  proposedSpec     String?
  proposedCategory String?
  proposedGroup    String?
  proposedUnit     String?

  // 报价与供货条件
  quotedPrice     Decimal? @db.Decimal(12, 2)
  deliveryPeriod  String?
  region          String?
  minOrder        String?
  taxIncluded     Boolean  @default(true)
  freightIncluded Boolean  @default(false)

  // 议价：管理员反报价
  counterPrice Decimal? @db.Decimal(12, 2)
  counterNote  String?

  // 资质说明 + 证明附件（FileAsset.id）
  qualificationNote     String?
  attachmentFileAssetId String?

  // 状态机：PENDING | COUNTERED | RETURNED | APPROVED | REJECTED | WITHDRAWN
  status       String    @default("PENDING")
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectReason String?
  reviewerNote String?

  // NEW_ITEM 通过时管理员填写的官方参考价（写入新建 CatalogItem）
  approvedReferencePrice Decimal?  @db.Decimal(12, 2)
  approvedPriceMin       Decimal?  @db.Decimal(12, 2)
  approvedPriceMax       Decimal?  @db.Decimal(12, 2)
  approvedValidUntil     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier    Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([supplierId, status])
  @@index([status, type])
  @@index([catalogItemId])
  @@index([supplierId, catalogItemId, status])
}

// ── 品类↔供应商准入关系（审核通过的产物，当前供货态）──

model CatalogSupplier {
  id                  String   @id @default(cuid())
  catalogItemId       String
  supplierId          String
  quotedPrice         Decimal  @db.Decimal(12, 2)
  deliveryPeriod      String?
  region              String?
  minOrder            String?
  taxIncluded         Boolean  @default(true)
  freightIncluded     Boolean  @default(false)
  status              String   @default("ACTIVE") // ACTIVE | SUSPENDED | DISABLED
  sourceApplicationId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  supplier    Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([catalogItemId, supplierId])
  @@index([catalogItemId, status])
}

// ── 操作审计日志 ──

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ── 全系统操作日志（拦截器自动落库，与手动埋点的 AuditLog 并行）──

model OperationLog {
  id         String   @id @default(cuid())
  userId     String?
  username   String?
  role       String?
  portal     String?
  method     String
  path       String
  query      String?
  body       Json?
  statusCode Int
  durationMs Int
  ipAddress  String?
  userAgent  String?
  referer    String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([role, createdAt])
  @@index([portal, createdAt])
  @@index([path, createdAt])
  @@index([statusCode, createdAt])
}

// ── 水叮当智能助手 ──

model AssistantConversation {
  id        String             @id @default(cuid())
  userId    String?
  title     String?            @default("新对话")
  summary   String?
  messages  AssistantMessage[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  role           String // user | assistant | tool_call | tool_result | system
  content        String                @db.Text
  toolCalls      Json?
  toolResult     Json?
  actions        Json?
  cardsJson      Json?
  citationsJson  Json?
  createdAt      DateTime              @default(now())
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

model AssistantActionLog {
  id             String    @id @default(cuid())
  conversationId String?
  actionType     String
  status         String // pending | confirmed | cancelled | success | failed
  targetType     String?
  targetId       String?
  payloadJson    Json
  resultJson     Json?
  riskLevel      String // low | medium | high
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  executedAt     DateTime?

  @@index([status])
}

model BidRequirementReview {
  id             String   @id @default(cuid())
  projectId      String
  bidderResultId String
  expertId       String
  requirementId  String
  category       String
  verdict        String // ack | dispute | doubt
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      BidProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bidderResult AiBidderResult @relation(fields: [bidderResultId], references: [id], onDelete: Cascade)
  expert       BidExpert      @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([projectId, bidderResultId, expertId, requirementId])
  @@map("bid_requirement_reviews")
}

model AssistantAlert {
  id        String   @id @default(cuid())
  userId    String
  type      String // deadline | anomaly | guidance
  title     String
  content   String   @db.Text
  severity  String   @default("info") // info | warning | urgent
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dismissed, createdAt])
  @@map("assistant_alerts")
}

// ═══════════════════════════════════════════════════════════════════════
// 采购中心模块（从 procurement 项目迁入）
// ═══════════════════════════════════════════════════════════════════════

// ── 采购中心枚举 ──

enum ResultStatus {
  AWARDED
  FAILED_REVIEW
  FILE_REVISION_REQUIRED
  INVALID_RESPONSE
  PENDING
  CANCELLED
}

enum SourceType {
  EXCEL_IMPORT
  MANUAL
  PROJECT_MANAGEMENT
}

enum AttachmentType {
  TENDER_DOCUMENT
  REVIEW_COMMENT
  BID_ANALYSIS
  AWARD_NOTICE
  CONTRACT
  SUPPORTING_MATERIAL
}

enum PasswordChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectManagementStatus {
  ACTIVE
  ARCHIVED
  RECYCLED
}

enum ProjectStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum WorkArrangementStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum WorkArrangementType {
  APPROVAL
  FOLLOW_UP
  WRITING
  COMMUNICATION
  REVIEW
  ARCHIVE
  RESEARCH
  MEETING
  OTHER
}

enum WorkArrangementUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkArrangementRecurrence {
  NONE
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

enum WorkArrangementNoteType {
  PROGRESS
  INSIGHT
}

// ── 用户设置 ──

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  theme             String   @default("system")
  defaultHomePage   String   @default("work-arrangements")
  compactMode       Boolean  @default(false)
  notificationPrefs Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── 采购项目（台账容器）──

model Project {
  id                     String             @id @default(cuid())
  projectCode            String?            @unique
  name                   String
  businessCategory       String?
  description            String?
  requestingDepartmentId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  attachments            Attachment[]
  procurementRounds      ProcurementRound[]
  requestingDepartment   Department?        @relation("ProjectRequestingDepartment", fields: [requestingDepartmentId], references: [id])

  @@index([name])
}

// ── 采购轮次（台账明细）──

model ProcurementRound {
  id                   String              @id @default(cuid())
  projectId            String
  roundNo              Int
  procurementDate      DateTime?
  procurementMethod    String
  departmentId         String?
  budgetAmount         Decimal?            @db.Decimal(14, 2)
  controlAmount        Decimal?            @db.Decimal(14, 2)
  awardedSupplierId    String?
  awardAmount          Decimal?            @db.Decimal(14, 2)
  resultStatus         ResultStatus        @default(PENDING)
  resultText           String?
  sourceType           SourceType          @default(MANUAL)
  supplierText         String?
  importBatchId        String?
  isRecycled           Boolean             @default(false)
  createdById          String?
  companyId            String?
  companyName          String? // 写时快照（公司改名不扰历史）
  company              Company?            @relation(fields: [companyId], references: [id])
  updatedById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  awardedSupplierName  String?
  expertInfo           String?
  biddingUnits         String?
  // ERP 采购项目关联（可选，桥接两个采购模型）
  procurementProjectId String?
  attachments          Attachment[]
  awardedSupplier      Supplier?           @relation("AwardedSupplier", fields: [awardedSupplierId], references: [id])
  createdBy            User?               @relation("RoundCreatedBy", fields: [createdById], references: [id])
  department           Department?         @relation("RoundDepartment", fields: [departmentId], references: [id])
  importBatch          ImportBatch?        @relation(fields: [importBatchId], references: [id])
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  procurementProject   ProcurementProject? @relation(fields: [procurementProjectId], references: [id], onDelete: SetNull)
  updatedBy            User?               @relation("RoundUpdatedBy", fields: [updatedById], references: [id])
  participants         RoundParticipant[]

  @@unique([projectId, roundNo])
  @@index([procurementDate])
  @@index([procurementMethod])
  @@index([resultStatus])
  @@index([isRecycled])
  @@index([procurementProjectId])
}

// ── 轮次参与供应商 ──

model RoundParticipant {
  id                 String           @id @default(cuid())
  procurementRoundId String
  supplierId         String
  sequenceNo         Int?
  participationRole  String?
  procurementRound   ProcurementRound @relation(fields: [procurementRoundId], references: [id], onDelete: Cascade)
  supplier           Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([procurementRoundId, supplierId])
}

// ── 附件（采购中心）──

model Attachment {
  id                       String                  @id @default(cuid())
  projectId                String?
  procurementRoundId       String?
  attachmentType           AttachmentType
  fileName                 String
  objectKey                String                  @unique
  mimeType                 String
  fileSize                 Int
  uploadedById             String?
  createdAt                DateTime                @default(now())
  projectManagementItemId  String?
  projectManagementStageId String?
  procurementRound         ProcurementRound?       @relation(fields: [procurementRoundId], references: [id])
  project                  Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectManagementItem    ProjectManagementItem?  @relation("ProjectManagementAttachments", fields: [projectManagementItemId], references: [id])
  projectManagementStage   ProjectManagementStage? @relation("ProjectManagementStageAttachments", fields: [projectManagementStageId], references: [id])
  uploadedBy               User?                   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  versions                 AttachmentVersion[]
  archiveMeta             ArchiveMetadata?

  @@index([attachmentType])
  @@index([projectManagementItemId])
  @@index([projectManagementStageId])
}

/// 采购文件补丁保存前的旧版本归档（定点补丁路径的回滚保险）
model AttachmentVersion {
  id            String     @id @default(cuid())
  attachmentId  String
  attachment    Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  objectKey     String     @unique
  fileSize      Int
  originalHash  String
  createdById   String?
  createdBy     User?      @relation("AttachmentVersionCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  changeSummary String? // 本次保存的变更摘要（旧→新 diff 概要，前端弹窗展示）

  @@index([attachmentId])
}

// ── 项目管理（全生命周期）──

model ProjectManagementItem {
  id                          String                   @id @default(cuid())
  title                       String
  requesterName               String
  requesterDepartment         String
  procurementMethod           String
  procurementCategory         String
  procurementOrganizationForm String
  budgetAmount                Decimal                  @db.Decimal(14, 2)
  isAnnualBudget              Boolean
  projectReason               String
  supplierRequirements        String
  currentStage                String
  status                      ProjectManagementStatus  @default(ACTIVE)
  archivedProcurementRoundId  String?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  analysisSummary             String?
  analysisUpdatedAt           DateTime?
  createdById                 String?
  companyId                   String?
  companyName                 String? // 写时快照（公司改名不扰历史）
  company                     Company?                 @relation(fields: [companyId], references: [id])
  initiationDate              DateTime?
  evaluationMethod            String?
  expertInfo                  String?
  biddingUnits                String?
  awardedSupplier             String?
  contractAmount              Decimal?                 @db.Decimal(14, 2)
  // ── B1（GB/T 43711 7.2.1.2 采购方案缺项补全）──
  implementerName             String? // 采购实施人（授权/委托实施采购的单位/部门，3.2.2）
  contractPricingType         String? // 合同计价类型（总价/单价/成本加酬金等）
  sectionPlan                 String? // 标段（标包/份额）划分说明
  activitySchedule            String? // 采购活动时间安排说明
  riskMeasures                String? // 风险管控措施
  gbProjectCode               String? // A1（B.4.3.2）：国标项目编码（18 位组合码，交易平台项目唯一标识）
  archivedAt                  DateTime?
  archiveHook                 String?
  hasProcurementDemand        Boolean                  @default(false)
  demandRequesterName         String?
  demandDepartment            String?
  demandProcurementTitle      String?
  demandProjectReason         String?
  demandSupplierReqs          String?
  demandBudgetAmount          Decimal?                 @db.Decimal(14, 2)
  demandProcurementCategory   String?
  demandProcurementMethod     String?
  demandProject               String?
  demandContractNumber        String?
  contractNumber              String?
  departmentNumber            String?
  projectCode                 String?                  @unique
  projectOverview             String?
  bidOpeningTime              String?
  documentAcquireTime         String?
  invitedSuppliers            String?
  paymentPerformance          String?
  attachments                 Attachment[]             @relation("ProjectManagementAttachments")
  createdBy                   User?                    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  // CTS-EBS01 A-36/37 递交与受理留痕：reviewStatus null=未递交 | PENDING | APPROVED | REJECTED（驳回后可改再递交）
  reviewStatus                String?
  submittedAt                 DateTime?
  submittedById               String?
  submittedBy                 User?                    @relation("ProjectSubmittedBy", fields: [submittedById], references: [id])
  reviewedAt                  DateTime?
  reviewedById                String?
  reviewedBy                  User?                    @relation("ProjectReviewedBy", fields: [reviewedById], references: [id])
  reviewComment               String?
  stages                      ProjectManagementStage[]
  workArrangements            WorkArrangement[]
  currentRound                Int                      @default(1) // 当前采购轮次（再次采购递增）
  bidProjects                 BidProject[]
  planItems                   ProjectPlanItem[]
  teamMembers                 ProjectTeamMember[]

  // ── DA/T 103-2024 归档（一卷单元）──
  retentionPeriod             ArchiveRetentionPeriod? // 保管期限（§9.3：永久/30年/10年）
  archiveExportedAt           DateTime? // 最近一次 ASIP 归档信息包导出时间（§8.2）
  archivePackageKey           String? // ASIP 包在 MinIO 的对象键（一卷一包，重导覆盖）
  archiveRegistrationKey      String? // 移交接收登记表扫描件（双套制线下签章回传，A.1h 纸电关联）

  @@index([status, currentStage])
  @@index([title])
  @@index([createdById])
}

// ── 归档域（DA/T 103-2024，2026-08-24；主线=项目管理 PMI 为卷）──

/// 保管期限三档（规范 §9.3）
enum ArchiveRetentionPeriod {
  PERMANENT // 永久
  Y30 // 定期 30 年
  Y10 // 定期 10 年
}

/// 归档范围表（规范 §6 + 附录 B 共 36 项；驱动阶段闸门/质检勾稽/ASIP 组包）
/// 招标文件澄清问答（CTS-EBS01 A-80/A-81，B-011）——供应商就招标文件提问，采购中心答复。
/// 与 BidClarification（评标澄清，评委→投标人）方向相反，勿混用。
model TenderClarification {
  id           String     @id @default(cuid())
  projectId    String
  supplierId   String?
  supplierName String
  question     String
  attachmentId String? // 提问附件 FileAsset
  status       String     @default("待答复") // 待答复 | 已答复
  answer       String?
  answeredBy   String? // User.id
  answeredAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  project      BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier     Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

/// 澄清与修改文件（A-82/A-83，B-012/B-015）——按项目版本递增，发布后并入招标文件下载范围。
model TenderClarificationDoc {
  id          String   @id @default(cuid())
  projectId   String
  version     Int // 第 N 次澄清，项目内从 1 递增
  title       String
  content     String   @default("") // 澄清说明正文
  fileAssetId String? // 澄清文件附件（PDF/DOCX）
  status      String   @default("草稿") // 草稿 | 已发布
  publishedAt DateTime?
  createdBy   String? // User.id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  receipts    TenderClarificationReceipt[]

  @@unique([projectId, version])
}

/// 澄清文件下载回执（A-85/A-86）——下载即回执，:3005 可查回执表。
model TenderClarificationReceipt {
  id           String   @id @default(cuid())
  docId        String
  supplierId   String
  downloadedAt DateTime @default(now())
  receiptedAt  DateTime @default(now()) // 回执递交时间（重复下载刷新）
  doc          TenderClarificationDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  supplier     Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([docId, supplierId])
}

/// C3 转非招标方式成交记录（CTS-EBS01 A-199）：流标项目改用非招标方式的成交结果登记。
/// 结构化字段入 ASIP「其他/非招标成交记录.json」；成交文件同时挂 PMI 定标阶段附件随档。
model NonTenderDealRecord {
  id              String    @id @default(cuid())
  bidProjectId    String    @unique
  pmItemId        String?
  method          String // 竞争性谈判 | 询价 | 单一来源
  winnerSupplierId String?
  winnerName      String
  dealAmount      Decimal?  @db.Decimal(14, 2)
  fileAssetId     String?
  note            String?
  recordedById    String?
  recordedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([pmItemId])
}

/// C4 阶段合规规则配置化：DB 覆盖层——某阶段有 enabled 行则用 DB 规则，
/// 空则回退内置代码表（stage-compliance-rules.ts）。支持在线改 criteria/停用单项。
model StageComplianceRule {
  id            String   @id @default(cuid())
  stageKey      String
  name          String
  dimension     String
  criteria      String
  regulationRef String
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([stageKey, name])
  @@index([stageKey])
}

model ArchiveScopeItem {
  id             String   @id @default(cuid())
  code           String   @unique // 附录 B 序号，如 "2.4"
  stage          String // 策划|招标|投标|开标|评标|中标|其他（规范七类）
  materialName   String // 材料名，如 "招标文件"
  sourceType     String // attachment=系统附件 | fileAsset=开评标回流件 | manual=人工补传 | generated=系统生成
  attachmentTypes String[] // AttachmentType 映射（sourceType=attachment）
  stageKeys      String[] // PMI 阶段映射（限定产生阶段；空=任意阶段）
  fileCategories String[] // FileAsset.category 映射（sourceType=fileAsset，回流件）
  isRequired     Boolean  @default(true) // 必选材料（缺件阻断阶段完成/检测不合格）
  keepByTenderer Boolean  @default(true) // 招标人保存（附录 B 三方勾选）
  keepByBidder   Boolean  @default(false) // 投标人保存
  keepByAgency   Boolean  @default(false) // 代理/平台机构保存
  sortOrder      Int      @default(0)
  metaRecords    ArchiveMetadata[]

  @@index([stage])
  @@index([sourceType])
}

/// 档案元数据（规范 §7.2 + 附录 C：对齐 DA/T 46 M22/M28/M32/M33；1:1 挂 Attachment 或回流 FileAsset）
model ArchiveMetadata {
  id              String    @id @default(cuid())
  attachmentId    String?   @unique
  fileAssetId     String?   @unique // 回流件（FileAsset）归档记录
  title           String? // M22 题名（"项目名·材料名"）
  persons         Json? // M28 人名（投标人/中标人等）
  responsibles    Json? // M32 责任者（招标人/经办部门）
  formedAt        DateTime? // M33 形成时间
  sourceModule    String? // 产生模块（stage-attachment/upload/handover…）
  autoCapturedAt  DateTime? // 自动捕获时间（null=纯手工）
  archivedAt      DateTime? // 文件级已归档标记（A.2d：防重复归档；可取消重归）
  scopeItemId     String? // 关联归档范围项（勾稽结果）
  attachment      Attachment? @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  fileAsset       FileAsset?  @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  scopeItem       ArchiveScopeItem? @relation(fields: [scopeItemId], references: [id])

  @@index([archivedAt])
  @@index([scopeItemId])
}

/// 四性检测结果（规范 §8.3/§10.3 + A.1f：完整性/可用性/安全性自动检测，真实性=哈希链弱对齐）
model ArchiveCheckResult {
  id            String   @id @default(cuid())
  pmiId         String
  overall       String // PASSED | FAILED
  passedCount   Int      @default(0)
  failedCount   Int      @default(0)
  details       Json // [{scopeCode, materialName, check, status, message}]
  ranAt         DateTime @default(now())
  ranById       String?

  @@index([pmiId, ranAt])
}

// CTS A-47/49 招标项目任务计划：条目挂 PMI，整包报审（submit/review 批量流转），双人留痕同 A-36/37 模式
model ProjectPlanItem {
  id                      String    @id @default(cuid())
  projectManagementItemId String
  content                 String
  ownerUserId             String?
  startDate               DateTime?
  endDate                 DateTime?
  sortOrder               Int       @default(0)
  status                  String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  submittedAt             DateTime?
  submittedById           String?
  reviewedAt              DateTime?
  reviewedById            String?
  reviewComment           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  projectManagementItem   ProjectManagementItem @relation(fields: [projectManagementItemId], references: [id], onDelete: Cascade)

  @@index([projectManagementItemId])
}

// CTS A-48 项目团队：成员与职责分工
model ProjectTeamMember {
  id                      String    @id @default(cuid())
  projectManagementItemId String
  userId                  String
  role                    String // 负责人 | 技术 | 商务 | 监督 | 其他
  duty                    String?
  createdAt               DateTime  @default(now())
  projectManagementItem   ProjectManagementItem @relation(fields: [projectManagementItemId], references: [id], onDelete: Cascade)
  user                    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectManagementItemId, userId])
  @@index([projectManagementItemId])
}

model ProjectManagementStage {
  id                      String                @id @default(cuid())
  projectManagementItemId String
  stageKey                String
  stageName               String
  stageOrder              Int
  round                   Int                   @default(1)
  status                  ProjectStageStatus    @default(NOT_STARTED)
  note                    String?
  completedAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  attachments             Attachment[]          @relation("ProjectManagementStageAttachments")
  projectManagementItem   ProjectManagementItem @relation(fields: [projectManagementItemId], references: [id], onDelete: Cascade)

  @@unique([projectManagementItemId, stageKey, round])
  @@index([projectManagementItemId, stageOrder])
}

// ── Excel 导入批次 ──

model ImportBatch {
  id                String             @id @default(cuid())
  fileName          String
  sourceMonth       String?
  rowCount          Int                @default(0)
  successCount      Int                @default(0)
  warningCount      Int                @default(0)
  errorCount        Int                @default(0)
  uploadedById      String?
  createdAt         DateTime           @default(now())
  uploadedBy        User?              @relation("ImportBatchUploadedBy", fields: [uploadedById], references: [id])
  procurementRounds ProcurementRound[]
}

// ── 工作安排（个人任务管理）──

model WorkArrangement {
  id                      String                      @id @default(cuid())
  userId                  String
  title                   String
  description             String?
  type                    WorkArrangementType
  urgency                 WorkArrangementUrgency      @default(MEDIUM)
  status                  WorkArrangementStatus       @default(TODO)
  dueAt                   DateTime?
  reminderAt              DateTime?
  estimatedMinutes        Int?
  isAllDay                Boolean                     @default(true)
  customTags              Json?
  recurrence              WorkArrangementRecurrence   @default(NONE)
  projectManagementItemId String?
  templateId              String?
  completionSummary       String?
  reflectionSummary       String?
  completedAt             DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  projectManagementItem   ProjectManagementItem?      @relation(fields: [projectManagementItemId], references: [id])
  template                WorkArrangementTemplate?    @relation(fields: [templateId], references: [id])
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dependents              WorkArrangementDependency[] @relation("WorkArrangementDependsOnTarget")
  dependencies            WorkArrangementDependency[] @relation("WorkArrangementDependsOnSource")
  notes                   WorkArrangementNote[]

  @@index([userId, status, dueAt])
  @@index([userId, urgency, dueAt])
  @@index([projectManagementItemId, dueAt])
}

model WorkArrangementNote {
  id                String                  @id @default(cuid())
  workArrangementId String
  type              WorkArrangementNoteType
  content           String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  workArrangement   WorkArrangement         @relation(fields: [workArrangementId], references: [id], onDelete: Cascade)

  @@index([workArrangementId, createdAt])
}

model WorkArrangementTemplate {
  id               String                    @id @default(cuid())
  userId           String
  name             String
  title            String
  description      String?
  type             WorkArrangementType
  urgency          WorkArrangementUrgency    @default(MEDIUM)
  estimatedMinutes Int?
  isAllDay         Boolean                   @default(true)
  customTags       Json?
  recurrence       WorkArrangementRecurrence @default(NONE)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  workArrangements WorkArrangement[]
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model WorkArrangementDependency {
  workArrangementId String
  dependsOnId       String
  createdAt         DateTime        @default(now())
  dependsOn         WorkArrangement @relation("WorkArrangementDependsOnTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)
  workArrangement   WorkArrangement @relation("WorkArrangementDependsOnSource", fields: [workArrangementId], references: [id], onDelete: Cascade)

  @@id([workArrangementId, dependsOnId])
  @@index([dependsOnId])
}

// ── 密码管理 ──

model PasswordChangeRequest {
  id                    String                      @id @default(cuid())
  userId                String
  requestedPasswordHash String
  status                PasswordChangeRequestStatus @default(PENDING)
  decisionNote          String?
  requestedAt           DateTime                    @default(now())
  reviewedAt            DateTime?
  approvedById          String?
  approvedBy            User?                       @relation("PasswordChangeRequestApprovedBy", fields: [approvedById], references: [id])
  user                  User                        @relation("PasswordChangeRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, requestedAt])
}

model PasswordResetRequest {
  id                String                      @id @default(cuid())
  requestedUsername String
  applicantName     String
  applicantContact  String
  matchedUserId     String?
  status            PasswordChangeRequestStatus @default(PENDING)
  decisionNote      String?
  requestedAt       DateTime                    @default(now())
  reviewedAt        DateTime?
  reviewedById      String?
  matchedUser       User?                       @relation("PasswordResetRequestUser", fields: [matchedUserId], references: [id])
  reviewedBy        User?                       @relation("PasswordResetRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([requestedUsername, status])
  @@index([matchedUserId, status])
  @@index([status, requestedAt])
}

// ── 资料变更申请（2026-08-24）：个人中心所有资料修改一律走审批，不再支持直改 ──
// payload 只存申请人提交的新值（白名单字段，null = 清除），批准时应用到 User；
// 审批界面以 User 当前值作旧值对照（批准前用户资料未变）。
model ProfileChangeRequest {
  id           String                      @id @default(cuid())
  userId       String
  payload      Json
  status       PasswordChangeRequestStatus @default(PENDING)
  decisionNote String?
  requestedAt  DateTime                    @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  user         User                        @relation("ProfileChangeRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?                       @relation("ProfileChangeRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([userId, status])
  @@index([status, requestedAt])
}

// ── 注册审核历史（append-only，不可删改）──
// 每次注册审批（通过/拒绝）写入一条不可变快照。拒绝会删除原 User，
// 故本表不建 User 外键——userId 仅作快照存证，历史永久保留。
model RegistrationReview {
  id             String   @id @default(cuid())
  userId         String // 被审核用户 ID（快照，不建外键）
  username       String
  displayName    String
  company        String
  department     String?
  phone          String
  email          String?
  officeLocation String?
  requestedRole  String // management | office
  decision       String // APPROVED | REJECTED
  decisionNote   String? // 审核理由
  reviewedById   String? // 审核人用户 ID
  reviewedByName String? // 审核人姓名（快照）
  reviewedAt     DateTime
  createdAt      DateTime @default(now())

  @@index([decision, reviewedAt])
  @@index([username, reviewedAt])
  @@map("registration_reviews")
}

// ── 公告操作历史（append-only，不可删改）──
// 记录每条公告的新建/发布/编辑/删除，含操作人与时间。删除公告会移除原记录，
// 故不建 Announcement 外键——announcementId 作快照，历史永久保留。
// content 变更不存全文（体积），存 SHA-256 指纹 + 长度以证明内容是否变化。
model AnnouncementHistory {
  id             String   @id @default(cuid())
  announcementId String // 快照，不建外键
  action         String // CREATE | PUBLISH | UPDATE | UNPUBLISH | ARCHIVE | DELETE
  title          String // 操作时标题快照
  type           String?
  status         String? // 操作后状态
  contentHash    String? // 操作时正文 SHA-256（证明内容版本）
  contentLength  Int?
  changedFields  String[] // 本次编辑变更的字段名列表
  operatorId     String? // 操作人用户 ID
  operatorName   String? // 操作人姓名（快照）
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([announcementId, createdAt])
  @@index([action, createdAt])
  @@map("announcement_histories")
}

// ── 知识库（RAG）──

model KnowledgeBase {
  id          String           @id @default(cuid())
  name        String
  description String?
  ownerId     String // 创建者；私有的按 ownerId 隔离，isShared=true 则全员可用
  isShared    Boolean          @default(false) // 共享：全员可「使用」，维护仅创建者(+admin)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rules       ComplianceRule[]
  files       KnowledgeFile[]
  reviewTasks ReviewTask[]
}

model KnowledgeFile {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  fileName        String
  objectKey       String
  mimeType        String
  fileSize        Int
  content         String?
  chunkCount      Int           @default(0)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
}

model DocumentChunk {
  id             String                 @id @default(cuid())
  collectionName String
  fileId         String
  content        String
  metadata       Json                   @default("{}")
  embedding      Unsupported("vector")?
  createdAt      DateTime               @default(now())

  @@index([collectionName])
}

model ComplianceRule {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  source          String
  name            String
  ruleType        String
  checkTarget     String
  logicExpression Json
  severity        String
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@index([ruleType])
}

// ── 招标文件审查 ──

model ReviewTask {
  id                      String         @id @default(cuid())
  documentName            String
  objectKey               String
  documentContent         String?
  knowledgeBaseId         String?
  reviewMode              String
  status                  String         @default("pending")
  totalChecks             Int            @default(0)
  passedCount             Int            @default(0)
  failedCount             Int            @default(0)
  warningCount            Int            @default(0)
  results                 Json?
  createdAt               DateTime       @default(now())
  completedAt             DateTime?
  modifiedDocumentContent String?
  userId                  String?
  knowledgeBase           KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id])
  user                    User?          @relation(fields: [userId], references: [id])

  @@index([knowledgeBaseId])
  @@index([status])
  @@index([userId])
}

// ── 标书字段样本 ──

model TenderFieldSample {
  id         String   @id @default(cuid())
  fieldKey   String
  content    String
  isFavorite Boolean  @default(false)
  sourceType String   @default("manual")
  context    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fieldKey, isFavorite])
  @@index([fieldKey, createdAt])
}

// ── 外部联系人 ──

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ── 标书版本历史 ──

model TenderDocumentHistory {
  id           String   @id @default(cuid())
  documentType String
  title        String
  draftData    Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  contentHash  String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, contentHash])
  @@index([documentType, createdAt])
  @@index([userId, createdAt])
}

// ── 规则提取任务 ──

model ExtractionTask {
  id              String   @id @default(cuid())
  knowledgeBaseId String?
  status          String   @default("pending")
  extractedCount  Int      @default(0)
  processedFiles  Json     @default("[]")
  error           String?
  createdAt       DateTime @default(now())

  @@index([status])
}

// ── 工作台每日计划缓存（持久化 AI 生成结果）──

model WorkArrangementDailyPlanCache {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD
  plan      Json // 完整的 dailyPlan 响应对象
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// 评分标准模板（用户保存的整套评分项 + 得分点，便于跨项目复用）
model ScoreTemplate {
  id            String   @id @default(cuid())
  name          String
  // { items: [{ category, name, maxScore, points: [{ name, fullScore, evidenceHint, objective }] }] }
  payload       Json
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([createdById])
}

/// 评标签字登记状态（《评标委员会和评标方法暂行规定》第四十三条语义）
enum SignStatus {
  PENDING // 待签
  SIGNED // 已签字
  REFUSED_DISSENT // 拒绝签字·附书面不同意见
  DEEMED_AGREED // 视为同意（拒绝且未陈述理由）
}

/// 评标签字包：签字包 PDF + 签字页扫描 + 闭环信息 + 回流包引用
model BidSignPacket {
  id                  String    @id @default(cuid())
  projectId           String    @unique
  fileAssetId         String // 签字包 PDF/DOCX（category=bid_sign_packet）
  sha256              String // 文件指纹
  generatedAt         DateTime
  generatedById       String
  signPageScanFileId  String? // 主报告签字页扫描件（全员共签页，category=sign_packet_signature_page）
  closedAt            DateTime? // 全员正选专家进入终态时自动置位
  closedById          String?
  handoverFileAssetId String? // 评标回流包（category=bid_evaluation_sign_handover），生成后置位
  handoverSha256      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project BidProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 无需 @@index([projectId])——@unique 已自带唯一索引
}

// ── 工作印记（Badge） ──

/// 印记定义（全系统共用一份，seed 注入）
model BadgeDefinition {
  code            String   @id
  name            String
  category        String // quantity | velocity | quality | tenure | collaboration
  description     String
  iconKey         String // Lucide 图标名
  levelThresholds Json // { bronze: 50, silver: 200, gold: 500, platinum: 1000 }
  unit            String // "项" | "天" | "个"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  userBadges UserBadge[]
}

/// 用户印记进度（每日 cron 计算）
model UserBadge {
  id            String   @id @default(cuid())
  userId        String
  badgeCode     String
  currentValue  Int      @default(0)
  currentLevel  String? // bronze | silver | gold | platinum | null
  awardedLevels Json // { bronze: "2026-03-12", silver: null }
  updatedAt     DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge BadgeDefinition @relation(fields: [badgeCode], references: [code])

  @@unique([userId, badgeCode])
  @@index([userId])
  @@index([badgeCode])
}

// ── 双信封 v2：证书体系（spec 2026-08-20 §3.1/§3.2）──

model SupplierCert {
  id            String   @id @default(cuid())
  supplierId    String
  certSn        String   @unique        // 证书序列号
  certDn        String                   // 证书主体（CN=企业名称,...）
  publicKey     String                   // SM2 公钥 hex（04 开头）
  alg           String   @default("SM2")
  bindingStatus String   @default("ACTIVE") // ACTIVE | REVOKED
  boundAt       DateTime @default(now())
  revokedAt     DateTime?
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  @@index([supplierId])
}

model AdminEncryptionCert {
  id        String   @id @default(cuid())
  publicKey String                   // SM2 公钥 hex
  certDn    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
