{
  "app": {
    /* 签名：DevEco Studio「File > Project Structure > Signing Configs」勾选自动签名
       （需登录华为账号）；上架签名材料（.p12/.cer/.p7b）由 AppGallery Connect 签发 */
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        /* API 26 时代格式：不带 (N) 后缀（version-const getHosCompileVersion：API≥26 纯平台版本号）；
           对齐 DevEco 26.0.1 自带 SDK（HarmonyOS 26.0.1/API 26）。真机若为 HarmonyOS 5.x 老 NEXT
           需在 SDK Manager 补装 5.0.0(12) 并改回带后缀格式 */
        "compatibleSdkVersion": "26.0.1",
        "targetSdkVersion": "26.0.1",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": ["default"] }
      ]
    }
  ]
}
