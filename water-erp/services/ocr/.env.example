# 引擎选择：rapid（默认，RapidOCR PP-OCRv4）| easy（需自行安装 easyocr）| opendataloader（docling 解析 + hybrid 并行 OCR）
OCR_ENGINE=rapid

# 图片最大边长（像素），超过自动等比缩放
OCR_MAX_SIDE=3000

# ── 并行与线程（低配生产机核心旋钮）──
# 线程铁律：OCR_NUM_WORKERS × OCR_INTRA_THREADS ≤ 分配给 OCR 的 CPU 核数
# 8 核机 6 核预算推荐预设：OCR_NUM_WORKERS=2 + OCR_INTRA_THREADS=3（即 2×3=6）
# 0/不设 = 不限制（onnxruntime 包默认，多核机器并发下会超额抢占）
# 页级并行 worker 数
# OCR_NUM_WORKERS=2
# onnxruntime 会话内线程（自动下推 Det/Cls/Rec 三会话）
# OCR_INTRA_THREADS=3
# onnxruntime 会话间线程
# OCR_INTER_THREADS=1

# ── 渲染与批次（内存/吞吐整形）──
# PDF 分块渲染页数：渲染→OCR→释放像素，控制峰值内存，内存紧张可减半
# OCR_CHUNK_PAGES=16
# 服务端渲染 dpi 默认（客户端显式传参可覆盖）
# OCR_DEFAULT_DPI=150
# 单请求处理页数上限默认（客户端显式传参可覆盖）
# OCR_MAX_PAGES_DEFAULT=200

# ── 文字层快速路径 ──
# 页内嵌文字层字符数达阈值则直接取文本免 OCR（数字原生 PDF 提速一个量级）；0=禁用恒走 OCR
# 护栏（自动生效）：含 U+FFFD 乱码层拒绝；页内嵌位图面积占比>10%（扫描证书等）该页回退 OCR
# OCR_TEXT_LAYER_MIN_CHARS=100

# ── 稳定性 / 内存控制（v1.2.0）──
# 单页 recognize 超时秒数；超过后 watchdog 终止进程，由 PM2 拉起、上游 BullMQ 重试
# OCR_PAGE_TIMEOUT=180
# 设 0 禁用 watchdog
# OCR_WATCHDOG=1

# ── Hybrid 服务器（仅 OCR_ENGINE=opendataloader 时生效）──
# 注意：ERP 实例（:8110）若与 :8100 实例并存且都用 opendataloader，端口段必须错开（如 5012）
# OCR_HYBRID_PORT=5002
# OCR_HYBRID_LANG=ch_sim,en
# OCR_HYBRID_DEVICE=cuda
# OCR_HYBRID_OCR_ENGINE=rapidocr
# OCR_HYBRID_WORKERS=2
