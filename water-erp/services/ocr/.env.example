# ───────────────────────── OCR 服务配置模板 ─────────────────────
# 用法：复制为 .env 后按需去掉行首注释；每项头顶注释即该项说明
# 低配生产机（8 核分 6 核给 OCR）推荐预设：NUM_WORKERS=2 × INTRA=3

# 引擎选择：rapid（默认，RapidOCR PP-OCRv4）| easy（需另装 easyocr）| opendataloader（docling+hybrid）
OCR_ENGINE=rapid

# 图片最大边长（像素），超过自动等比缩放
OCR_MAX_SIDE=3000

# 页级并行 worker 数；线程铁律：OCR_NUM_WORKERS × OCR_INTRA_THREADS ≤ 分给 OCR 的核数
# OCR_NUM_WORKERS=2

# onnxruntime 会话内线程（自动下推 Det/Cls/Rec 三会话；0=不限）
# OCR_INTRA_THREADS=3

# onnxruntime 会话间线程（0=不限，一般无需调整）
# OCR_INTER_THREADS=1

# PDF 分块渲染页数：渲染→OCR→释放像素，控制峰值内存（默认 16；内存紧张减半）
# OCR_CHUNK_PAGES=16

# 服务端渲染 dpi 默认（消费端不传 dpi，此值即唯一权威）
# OCR_DEFAULT_DPI=150

# 单请求处理页数上限默认（消费端显式传 max_pages 可覆盖）
# OCR_MAX_PAGES_DEFAULT=200

# 文字层快速路径阈值：页内嵌文字层字符数达此值直接取文本免 OCR（0=禁用恒走 OCR）
# 护栏自动生效：含 U+FFFD 乱码层拒绝；页内位图面积占比>10% 回退 OCR
# OCR_TEXT_LAYER_MIN_CHARS=100

# watchdog 单页 recognize 超时秒数，超时自杀交 PM2 拉起（默认 180）
# OCR_PAGE_TIMEOUT=180

# watchdog 总开关（1=开，0=关）
# OCR_WATCHDOG=1

# ── 以下 Hybrid 组仅 OCR_ENGINE=opendataloader 时生效 ──
# hybrid 子进程起始端口（与其他 OCR 实例并存时段须错开）
# OCR_HYBRID_PORT=5002

# hybrid OCR 语言（EasyOCR 代码）
# OCR_HYBRID_LANG=ch_sim,en

# hybrid 声明设备
# OCR_HYBRID_DEVICE=cuda

# hybrid OCR 后端（rapidocr=PP-OCRv4，需 venv 补丁）
# OCR_HYBRID_OCR_ENGINE=rapidocr

# hybrid 并行子进程数
# OCR_HYBRID_WORKERS=2
