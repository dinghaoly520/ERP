{
  "name": "water-erp",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:kill": "bash scripts/dev-kill.sh",
    "dev": "pnpm dev:kill && concurrently -n mall,supplier,web,expert,public,bid,api,assistant,bigscreen,mobile,ai-worker -c magenta,green,blue,purple,cyan,red,yellow,white,gray,#5bc0de,#ff8f00 \"pnpm dev:mall\" \"pnpm dev:supplier\" \"pnpm dev:web\" \"pnpm dev:expert\" \"pnpm dev:public\" \"pnpm dev:bid\" \"pnpm dev:api\" \"pnpm dev:assistant\" \"pnpm dev:bigscreen\" \"pnpm dev:mobile\" \"pnpm dev:ai-worker\"",
    "dev:api": "pnpm --filter api start:dev",
    "dev:ai-worker": "sleep 20 && pnpm --filter api dev:worker:ai-bid-analysis",
    "dev:assistant": "pnpm --filter assistant dev",
    "dev:bid": "pnpm --filter bid-portal dev",
    "dev:public": "pnpm --filter public-portal dev",
    "dev:web": "pnpm --filter web dev",
    "dev:mall": "pnpm --filter mall dev",
    "dev:expert": "pnpm --filter expert-portal dev",
    "dev:mobile": "pnpm --filter mobile-portal dev",
    "dev:bigscreen": "pnpm --filter bigscreen dev",
    "dev:supplier": "pnpm --filter supplier-portal-next dev",
    "dev:ocr": "cd services/ocr && bash start.sh",
    "dev:ukey-mw": "cd services/ukey-middleware && bash start.sh",
    "dev:ukey-mw-guard": "cd services/ukey-middleware && bash start-guard.sh",
    "dev:ukey-mw-usb": "cd services/ukey-middleware && bash start-usb.sh",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build:assistant": "pnpm --filter assistant build",
    "build:bid": "pnpm --filter bid-portal build",
    "build:mall": "pnpm --filter mall build",
    "build:expert": "pnpm --filter expert-portal build",
    "build:supplier": "pnpm --filter supplier-portal-next build",
    "build:public": "pnpm --filter public-portal build",
    "build:mobile": "pnpm --filter mobile-portal build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:studio": "pnpm --filter api exec prisma studio",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "db:validate": "pnpm --filter api exec prisma validate",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^6.0.3"
  }
}
